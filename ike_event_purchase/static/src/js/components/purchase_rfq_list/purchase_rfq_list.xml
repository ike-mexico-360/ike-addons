<t t-name="ike_event_purchase.PurchaseRfqList" owl="1">
  <div class="o_purchase_order_list">
    <t t-if="state.loading">
      <div class="text-center">Loading...</div>
    </t>
    <t t-else="">
      <!-- Header KPI restricted by company settings AND supplier advanced portal permission -->
      <div t-if="state.showKpi and state.hasAdvancedPortal" class="mb-4">
          <h1 class="fw-bold display-5 mb-3">
              Cost Review
          </h1>
          <div class="row g-3">

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Total orders</div>
                          <span class="kpi-value"><t t-out="totalOrdersCount"/></span>
                      </div>
                  </div>
              </div>

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Subtotal OC</div>
                          <span class="kpi-value"><t t-out="formatCurrency(subtotalOrdersAmount)"/></span>
                      </div>
                  </div>
              </div>

          </div>

      </div>
      <!-- Filters Bar -->
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
          <div class="row g-3 align-items-end">
            <div class="col-md-5">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-search me-1"/>Quotation
              </label>
              <input type="text"
                class="form-control form-control-sm rounded-pill"
                placeholder="Search by Quotation..."
                t-att-value="state.filters.reference"
                t-on-input="(ev) => this.onFilterChange('reference', ev.target.value)"/>
            </div>
            <div class="col-md-5">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-calendar me-1"/>Event
              </label>
              <input type="text"
                class="form-control form-control-sm rounded-pill"
                placeholder="Search by event..."
                t-att-value="state.filters.event"
                t-on-input="(ev) => this.onFilterChange('event', ev.target.value)"/>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button class="btn btn-sm btn-outline-secondary rounded-pill w-100"
                title="Clear filters"
                t-on-click="clearFilters">
                <i class="fa fa-times"/>Clear
              </button>
            </div>
          </div>
        </div>
      </div>
      <PaginationComponent pagination="pagination">
        <table class="table table-hover table-striped align-middle mb-0" style="border-collapse: separate; border-spacing: 0;">
          <thead>
            <tr class="active">
              <th class="text-start">
                <span class="d-none d-md-inline">Request for Quotation</span>
                <span class="d-block d-md-none">Ref.</span>
              </th>
              <th class="text-start">Event</th>
              <th class="text-start"></th>
              <th class="text-start">Deadline</th>
              <th class="text-start">Subtotal</th>
              <th class="text-start">Untaxed Amount Dispute</th>
              <th class="text-start">Untaxed Amount Approved</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="pagination.paginatedItems" t-as="rfq" t-key="rfq.id">
              <tr>
                <td class="text-start">
                  <a t-att-href="'/my/purchase/' + rfq.id"><t t-esc="rfq.name"/></a>
                </td>
                <td class="text-start"><t t-esc="rfq.x_event_id ? rfq.x_event_id.name : ''"/></td>
                <td class="text-start">
                  <t t-if="rfq.state === 'to_consolidate' or rfq.state === 'consolidated'">
                    <span class="badge bg-success">Accepted</span>
                  </t>
                </td>
                <td class="text-start"><t t-esc="formatDate(rfq.date_order)"/></td>
                <td class="text-start"><t t-esc="rfq.amount_untaxed"/></td>
                <td class="text-start"><t t-esc="rfq.amount_untaxed_dispute"/></td>
                <td class="text-start"><t t-esc="rfq.amount_untaxed_approved"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </PaginationComponent>
    </t>
  </div>
</t>
