<templates id="template" xml:space="preserve">
    <!-- Shared "Precios" info card, used by both PurchaseOrderDetails and
         PurchaseOrderReviewsDetails so supplier/invoicing/event/logistics info
         renders identically no matter which list (Purchase Orders, Order Review,
         RFQs) the user came from. Requires the calling component to expose
         state.order_data plus formatDate(), formatCurrency(), stripHtml() and
         the isInRfqList getter. -->
    <t t-name="ike_event_purchase.PurchaseOrderPriceInfoCard">
        <t t-if="state.order_data">
            <div class="card border-0 rounded-3 mb-3" style="background: linear-gradient(135deg, #f8f9ff 0%, #eef1fb 100%); border-left: 4px solid #4e73df !important;">
                <div class="card-body py-3 px-4">
                    <div class="row g-4">
                        <!-- Column 1: Supplier -->
                        <div class="col-12 col-lg-3">
                            <div class="d-flex flex-column gap-3">
                                <div t-if="state.order_data.partner_id" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-building text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Supplier
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.partner_id.name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_supplier_address" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-map-marker text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Supplier Address
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_supplier_address"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_supplier_vat" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-id-card text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Supplier RFC
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_supplier_vat"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_supplier_phone" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-phone text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Supplier Phone
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_supplier_phone"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Column 2: Invoicing Company (Empresa Facturadora) -->
                        <div class="col-12 col-lg-3">
                            <div class="d-flex flex-column gap-2 rounded-3 p-2 h-100" style="background:rgba(78,115,223,0.06); border-left:3px solid rgba(78,115,223,0.4);">
                                <div t-if="state.order_data.x_invoice_company_names" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-university text-secondary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Invoicing Company
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_invoice_company_names"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_invoice_company_address" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-map-marker text-secondary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Address
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_invoice_company_address"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_invoice_company_vat" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-id-card text-secondary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            RFC
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_invoice_company_vat"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_invoice_company_phone" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-phone text-secondary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Phone
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_invoice_company_phone"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Column 3: Event -->
                        <div class="col-12 col-lg-3">
                            <div class="d-flex flex-column gap-3">
                                <div t-if="state.order_data.x_event_public_id or state.order_data.x_event_id" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-tag text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Event
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="(state.order_data.x_event_public_id || state.order_data.x_event_id)?.name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.account_name" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-university text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Account
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_info?.account_name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_payment_event_type_id" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-credit-card text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Payment Event Type
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_payment_event_type_id.name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.event_date" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-calendar text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Event Date
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.x_event_info?.event_date)"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.date_approve" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-check-circle text-success mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Confirmation Date
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.date_approve)"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_ref_sap" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-barcode text-secondary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Ref. SAP
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_ref_sap"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.nu_name" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-user text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            NU Name
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_info?.nu_name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.date_planned" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-clock-o text-warning mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Receipt Date
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.date_planned)"/>
                                    </div>
                                </div>
                                <!-- <t t-if="isInRfqList">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="fa fa-money text-success mt-1" style="width:14px;"/>
                                        <div>
                                            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                Authorized Amount
                                            </div>
                                            <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatCurrency(state.order_data.x_authorized_amount)"/>
                                        </div>
                                    </div>
                                </t> -->
                            </div>
                        </div>
                        <!-- Column 4: Logistics -->
                        <div class="col-12 col-lg-3">
                            <div class="d-flex flex-column gap-3">
                                <div t-if="state.order_data.x_event_info?.location_label" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-map-marker text-success mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Origin
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="stripHtml(state.order_data.x_event_info?.location_label)"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.location_latitude" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-crosshairs text-success mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Coordinates
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;"><t t-out="state.order_data.x_event_info.location_latitude"/>, <t t-out="state.order_data.x_event_info.location_longitude"/></div>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.destination_label" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-flag-checkered text-danger mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Destination
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="stripHtml(state.order_data.x_event_info?.destination_label)"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.destination_latitude" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-crosshairs text-danger mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Coordinates
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;"><t t-out="state.order_data.x_event_info.destination_latitude"/>, <t t-out="state.order_data.x_event_info.destination_longitude"/></div>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.maneuvers" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-check-circle text-success mt-1" style="width:14px;"/>
                                    <div class="fw-semibold" style="font-size:0.9rem;">
                                        Maneuvers
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.vehicle_name" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-truck text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                            Vehicle
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_info?.vehicle_name"/>
                                    </div>
                                </div>
                                <div t-if="state.order_data.x_event_info?.vehicle_plate" class="d-flex align-items-start gap-2">
                                    <i class="fa fa-barcode text-primary mt-1" style="width:14px;"/>
                                    <div>
                                        <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                           Plate
                                        </div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">
                                            <span class="badge rounded-pill px-2 py-1" style="background:#e8edf8; color:#2c4a9e; font-size:0.85rem; letter-spacing:0.08em;" t-out="state.order_data.x_event_info?.vehicle_plate"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>
