<templates id="template" xml:space="preserve">
    <t t-name="ike_event_purchase.PurchaseOrderDetails">
        <div>
            <t t-if="state.order_data">
                <div t-if="state.order_data.x_dispute_state == 'submitted'" class="alert alert-warning alert-dismissible d-print-none" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                    <strong>
                        <t t-out="translate('The dispute has been submitted.')"/>
                    </strong>
                </div>
                <div t-if="state.order_data.x_dispute_state == 'resolved' and state.order_data.x_dispute_approved" class="alert alert-success alert-dismissible d-print-none" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                    <strong>
                        <t t-out="translate('The dispute has been approved.')"/>
                    </strong>
                </div>
                <div t-if="state.order_data.x_dispute_state == 'rejected'" class="alert alert-danger alert-dismissible d-print-none" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
                    <strong>
                        <t t-out="translate('The dispute has been rejected.')"/>
                    </strong>
                </div>
                <!-- Event Info -->
                <t t-if="state.order_data">
                    <div class="card border-0 rounded-3 mb-3" style="background: linear-gradient(135deg, #f8f9ff 0%, #eef1fb 100%); border-left: 4px solid #4e73df !important;">
                        <div class="card-body py-3 px-4">
                            <div class="row g-3">
                                <!-- Order metadata -->
                                <t t-if="state.order_data.partner_id">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-building text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;"><t t-out="translate('Supplier')"/></div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.partner_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_public_id or state.order_data.x_event_id">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-tag text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;"><t t-out="translate('Event')"/></div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_public_id ? state.order_data.x_event_public_id.name : state.order_data.x_event_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.company_id">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-home text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;"><t t-out="translate('Company')"/></div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.company_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.date_approve">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-check-circle text-success mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;"><t t-out="translate('Confirmation Date')"/></div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.date_approve)"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.date_planned">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-clock-o text-warning mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;"><t t-out="translate('Receipt Date')"/></div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.date_planned)"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.nu_name">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-user text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('NU Name')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_info.nu_name"/>
                                        </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.event_date">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-calendar text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('Event Date')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="formatDate(state.order_data.x_event_info.event_date)"/>
                                        </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.vehicle_name">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-truck text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('Vehicle')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="state.order_data.x_event_info.vehicle_name"/>
                                        </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.vehicle_plate">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-barcode text-primary mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('Plate')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;">
                                                    <span class="badge rounded-pill px-2 py-1" style="background:#e8edf8; color:#2c4a9e; font-size:0.85rem; letter-spacing:0.08em;" t-out="state.order_data.x_event_info.vehicle_plate"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.location_label">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-map-marker text-success mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('Origin')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="stripHtml(state.order_data.x_event_info.location_label)"/>
                                        </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="state.order_data.x_event_info and state.order_data.x_event_info.destination_label">
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="fa fa-flag-checkered text-danger mt-1" style="width:14px;"/>
                                            <div>
                                                <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.05em;">
                                                    <t t-out="translate('Destination')"/>
                                                </div>
                                                <div class="fw-semibold" style="font-size:0.9rem;" t-out="stripHtml(state.order_data.x_event_info.destination_label)"/>
                                        </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="row" t-if="state.order_data.state == 'sent'">
                    <div class="col-12">
                        <div class="d-flex flex-row justify-content-end">
                            <!-- ToDo: Mostrar también cuando ya se aprobó los cambios -->
                            <button class="btn text-white bg-success bg-opacity-10 rounded-pill px-3 shadow-sm me-2 mb-2" t-on-click="accept_prices" t-if="!state.show_dispute_fields &amp;&amp; ['none', 'resolved'].includes(state.order_data.x_dispute_state)">
                                <t t-out="translate('Accept')"/>
                            </button>
                            <button class="btn text-white bg-danger bg-opacity-10 rounded-pill px-3 me-2 mb-2" t-on-click="toggle_dispute_fields" t-if="!state.show_dispute_fields &amp;&amp; ['none', 'resolved'].includes(state.order_data.x_dispute_state)">
                                <t t-out="translate('Start Dispute')"/>
                            </button>
                            <button class="btn text-white bg-danger bg-opacity-10 rounded-pill px-3 me-2 mb-2" t-on-click="toggle_dispute_fields" disabled="disabled" t-if="state.show_dispute_fields &amp;&amp; ['none', 'resolved'].includes(state.order_data.x_dispute_state)">
                                <t t-out="translate('Start Dispute')"/>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="border-radius:14px;box-shadow:0 1px 0 #e7e6e2, 0 8px 24px rgba(30,30,25,0.06);">
                    <table class="mb-0" style="border-collapse:separate; border-spacing:0; width:100%; background:#fff; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13.5px; font-variant-numeric:tabular-nums;">
                        <t t-set="show_cds_columns" t-value="['sent', 'to_consolidate', 'consolidated'].includes(state.order_data.state)"/>
                        <t t-set="has_new_lines" t-value="state.order_data.order_line.some(l => l.new_line)"/>
                        <t t-set="show_dispute_columns" t-value="state.show_dispute_fields || state.order_data.x_dispute_state == 'submitted' || ['resolved', 'rejected'].includes(state.order_data.x_dispute_state)"/>
                        <t t-set="show_approved_columns" t-value="['resolved', 'rejected'].includes(state.order_data.x_dispute_state)"/>
                        <t t-set="show_dispute_values" t-value="['submitted', 'resolved', 'rejected'].includes(state.order_data.x_dispute_state) &amp;&amp; !state.show_dispute_fields"/>
                        <thead>
                            <!-- Row 1: Group labels -->
                            <tr style="font-size:11.5px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; text-align:center;">
                                <th rowspan="2" style="background:#f4f3f0; color:#1c1d1f; padding:10px 16px; text-align:left; white-space:nowrap;">
                                    <t t-out="translate('Concept')"/>
                                </th>
                                <th rowspan="2" style="background:rgba(100,60,160,0.16); color:#4a2070; padding:10px 8px; white-space:nowrap; text-align:center;">
                                    <t t-out="translate('Agreement Cost')"/>
                                </th>
                                <th t-if="show_cds_columns" colspan="3" style="background:rgba(140,138,128,0.16); color:#4a4940; padding:10px 8px; white-space:nowrap;">
                                    <t t-out="translate('CDS Quotation')"/>
                                </th>
                                <th colspan="3" style="background:rgba(63,107,74,0.16); color:#2c4a34; padding:10px 8px; white-space:nowrap;">
                                    <t t-out="translate('Final Cost')"/>
                                </th>
                                <th t-if="show_dispute_columns" colspan="3" style="background:rgba(185,129,44,0.16); color:#7a5419; padding:10px 8px; white-space:nowrap;">
                                    <t t-out="translate('Disputed Cost')"/>
                                </th>
                                <th t-if="show_approved_columns" colspan="3" style="background:rgba(58,95,143,0.16); color:#254670; padding:10px 8px; white-space:nowrap;">
                                    <t t-out="translate('CCC Approved Cost')"/>
                                </th>
                                <th t-if="has_new_lines" rowspan="2" style="background:#f4f3f0; width:40px;"></th>
                            </tr>
                            <!-- Row 2: Sub-column labels -->
                            <tr style="font-size:11px; font-weight:600; letter-spacing:0.03em; text-transform:uppercase; text-align:center; border-bottom:1.5px solid rgba(0,0,0,0.06);">
                                <t t-if="show_cds_columns">
                                    <th style="background:rgba(140,138,128,0.2); color:#4a4940; padding:9px 8px; white-space:nowrap; min-width:70px;"><t t-out="translate('Quantity')"/></th>
                                    <th style="background:rgba(140,138,128,0.2); color:#4a4940; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Unit Price CTO')"/></th>
                                    <th style="background:rgba(140,138,128,0.2); color:#4a4940; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Subtotal')"/></th>
                                </t>
                                <th style="background:rgba(63,107,74,0.2); color:#2c4a34; padding:9px 8px; white-space:nowrap; min-width:70px;"><t t-out="translate('Quantity')"/></th>
                                <th style="background:rgba(63,107,74,0.2); color:#2c4a34; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Unit Price CTO')"/></th>
                                <th style="background:rgba(63,107,74,0.2); color:#2c4a34; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Subtotal')"/></th>
                                <t t-if="show_dispute_columns">
                                    <th style="background:rgba(185,129,44,0.2); color:#7a5419; padding:9px 8px; white-space:nowrap; min-width:70px;"><t t-out="translate('Quantity')"/></th>
                                    <th style="background:rgba(185,129,44,0.2); color:#7a5419; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Unit Price CTO')"/></th>
                                    <th style="background:rgba(185,129,44,0.2); color:#7a5419; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Subtotal')"/></th>
                                </t>
                                <t t-if="show_approved_columns">
                                    <th style="background:rgba(58,95,143,0.2); color:#254670; padding:9px 8px; white-space:nowrap; min-width:70px;"><t t-out="translate('Quantity')"/></th>
                                    <th style="background:rgba(58,95,143,0.2); color:#254670; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Unit Price CTO')"/></th>
                                    <th style="background:rgba(58,95,143,0.2); color:#254670; padding:9px 8px; white-space:nowrap; min-width:80px;"><t t-out="translate('Subtotal')"/></th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.order_data.order_line" t-as="line" t-key="line.id">
                                <t t-if="line.display_type === 'line_section'">
                                    <tr>
                                        <td colspan="20" style="background:#f7f6f2; color:#5b5d63; font-size:12px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; text-align:left; padding:9px 16px; border-top:1px solid #e7e6e2; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="line.display_name"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-elif="line.display_type === 'line_note'">
                                    <tr>
                                        <td colspan="20" class="text-muted fst-italic" style="padding:9px 16px; font-size:12px; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="line.display_name"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-set="is_new_line" t-value="line.new_line"/>
                                    <tr style="transition:background 0.1s;">
                                        <!-- Concepto -->
                                        <td style="padding:11px 16px; text-align:left; font-weight:600; color:#1c1d1f; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                            <span t-out="line.display_name" t-if="!is_new_line"/>
                                            <t t-if="is_new_line">
                                                <select class="form-select form-select-sm" name="product_id"
                                                t-att-style="state.invalid_lines.has(line.id + '_product_id') ? 'border:1px solid #dc3545;' : ''"
                                                t-on-change="(ev) => onchange_disputed_value(line.id, 'product_id', +ev.target.value)">
                                                    <option value=""><t t-out="translate('Select concept')"/></option>
                                                    <t t-foreach="state.product_ids" t-as="product" t-key="product_index">
                                                        <option t-att-value="product.id" t-out="product.name"/>
                                                    </t>
                                                </select>
                                            </t>
                                        </td>
                                        <!-- Costo Convenio -->
                                        <td style="padding:11px 8px; text-align:right; background:rgba(100,60,160,0.1); color:#4a2070; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="formatNumber(line.x_base_unit_price)"/>
                                        </td>
                                        <!-- Cotización CDS -->
                                        <t t-if="show_cds_columns">
                                            <td style="padding:11px 8px; text-align:right; background:rgba(140,138,128,0.2); color:#4a4940; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_product_qty_event)" t-if="!is_new_line"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(140,138,128,0.2); color:#4a4940; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_unit_event)" t-if="!is_new_line"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(140,138,128,0.2); color:#4a4940; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_subtotal_event)" t-if="!is_new_line"/>
                                            </td>
                                        </t>
                                        <!-- Costo Final -->
                                        <td style="padding:11px 8px; text-align:right; background:rgba(63,107,74,0.2); color:#2c4a34; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="formatNumber(line.product_qty)" t-if="!is_new_line"/>
                                        </td>
                                        <td style="padding:11px 8px; text-align:right; background:rgba(63,107,74,0.2); color:#2c4a34; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="formatNumber(line.price_unit)"/>
                                        </td>
                                        <td style="padding:11px 8px; text-align:right; background:rgba(63,107,74,0.2); color:#2c4a34; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                            <t t-out="formatNumber(line.price_subtotal)" t-if="!is_new_line"/>
                                        </td>
                                        <!-- Costo Disputado -->
                                        <t t-if="show_dispute_columns">
                                            <td style="padding:11px 8px; text-align:right; background:rgba(185,129,44,0.2); color:#7a5419; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_product_qty_dispute)" t-if="show_dispute_values"/>
                                                <input t-if="is_new_line || state.show_dispute_fields" type="number"
                                                class="form-control form-control-sm text-end" style="min-width:70px;"
                                                t-att-value="formatNumber(line.x_product_qty_dispute)"
                                                t-on-change="(ev) => onchange_disputed_value(line.id, 'x_product_qty_dispute', +ev.target.value)"
                                                t-att-style="state.invalid_lines.has(line.id + '_x_product_qty_dispute') ? 'border:1px solid #dc3545;' : ''"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(185,129,44,0.2); color:#7a5419; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_unit_dispute)" t-if="show_dispute_values"/>
                                                <input t-if="is_new_line || state.show_dispute_fields" type="number"
                                                class="form-control form-control-sm text-end" style="min-width:80px;"
                                                t-att-value="formatNumber(line.x_price_unit_dispute)"
                                                t-on-change="(ev) => onchange_disputed_value(line.id, 'x_price_unit_dispute', +ev.target.value)"
                                                t-att-style="state.invalid_lines.has(line.id + '_x_price_unit_dispute') ? 'border:1px solid #dc3545;' : ''"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(185,129,44,0.2); color:#7a5419; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_subtotal_dispute)" t-if="show_dispute_values and !is_new_line"/>
                                                <t t-if="(is_new_line || state.show_dispute_fields) and !show_dispute_values">
                                                    <t t-out="formatNumber((line.x_product_qty_dispute || 0) * (line.x_price_unit_dispute || 0))"/>
                                                </t>
                                            </td>
                                        </t>
                                        <!-- Costo Aprobado CCC -->
                                        <t t-if="show_approved_columns">
                                            <td style="padding:11px 8px; text-align:right; background:rgba(58,95,143,0.2); color:#254670; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_product_qty_approved)" t-if="!is_new_line"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(58,95,143,0.2); color:#254670; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_unit_approved)" t-if="!is_new_line"/>
                                            </td>
                                            <td style="padding:11px 8px; text-align:right; background:rgba(58,95,143,0.2); color:#254670; white-space:nowrap; border-bottom:1px solid #e7e6e2;">
                                                <t t-out="formatNumber(line.x_price_subtotal_approved)" t-if="!is_new_line"/>
                                            </td>
                                        </t>
                                        <td t-if="is_new_line" style="padding:8px; text-align:center; border-bottom:1px solid #e7e6e2;">
                                            <button class="btn btn-sm btn-outline-danger rounded-circle p-0"
                                            style="width:28px; height:28px; line-height:1;"
                                            t-on-click="() => remove_line(line.id)">
                                                <i class="fa fa-times"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <!-- Subtotal row -->
                            <tr style="border-top:2px solid #1c1d1f; font-weight:700; font-size:14px;">
                                <td style="padding:13px 16px; text-align:left; color:#1c1d1f;">
                                    <t t-out="translate('Subtotal')"/>
                                </td>
                                <td style="padding:13px 8px; text-align:right; background:rgba(100,60,160,0.18); color:#4a2070;"></td>
                                <t t-if="show_cds_columns">
                                    <td style="padding:13px 8px; text-align:right; background:rgba(140,138,128,0.28); color:#4a4940;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(140,138,128,0.28); color:#4a4940;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(140,138,128,0.28); color:#4a4940;">
                                        <span t-out="formatNumber(state.order_data.amount_untaxed_event)"/>
                                    </td>
                                </t>
                                <td style="padding:13px 8px; text-align:right; background:rgba(63,107,74,0.28); color:#2c4a34;"></td>
                                <td style="padding:13px 8px; text-align:right; background:rgba(63,107,74,0.28); color:#2c4a34;"></td>
                                <td style="padding:13px 8px; text-align:right; background:rgba(63,107,74,0.28); color:#2c4a34;">
                                    <span t-out="formatNumber(state.order_data.amount_untaxed)"/>
                                </td>
                                <t t-if="show_dispute_columns">
                                    <td style="padding:13px 8px; text-align:right; background:rgba(185,129,44,0.28); color:#7a5419;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(185,129,44,0.28); color:#7a5419;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(185,129,44,0.28); color:#7a5419;">
                                        <span t-out="formatNumber(state.order_data.amount_untaxed_dispute)"/>
                                    </td>
                                </t>
                                <t t-if="show_approved_columns">
                                    <td style="padding:13px 8px; text-align:right; background:rgba(58,95,143,0.28); color:#254670;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(58,95,143,0.28); color:#254670;"></td>
                                    <td style="padding:13px 8px; text-align:right; background:rgba(58,95,143,0.28); color:#254670;">
                                        <span t-out="formatNumber(state.order_data.amount_untaxed_approved)"/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="row text-center mb-3" t-if="state.show_dispute_fields">
                    <div class="col-12 mb-3 mt-3">
                        <button class="btn text-white bg-primary bg-opacity-10 rounded-pill px-3" t-on-click="add_line">
                            <t t-out="translate('Add concept')"/>
                        </button>
                    </div>
                    <div class="col-12 mb-3">
                        <span>
                            <t t-out="translate('Specify the reason for the change')"/>
                        </span>
                        <input t-if="state.show_dispute_fields" type="text" class="form-control text-start"
                        t-att-value="state.order_data.x_change_comments" required="true" t-ref="x_change_comments"
                        t-on-change="(ev) => onchange_reasons('x_change_comments', ev.target.value)"
                        t-att-style="state.highlight_change_reason ? 'border: 1px solid red' : ''"
                    />
                    </div>
                    <div class="col-12">
                        <button class="btn text-white bg-success bg-opacity-10 rounded-pill px-3 shadow-sm me-2" t-on-click="send_dispute" t-if="state.show_dispute_fields">
                            <t t-out="translate('Send Dispute')"/>
                        </button>
                    </div>
                </div>
                <!-- Files Section -->
                <!-- <div t-if="isInRfqList" class="card border-0 shadow-sm rounded-3 mt-4">
                <div class="card-header bg-light d-flex align-items-center gap-2 py-2">
                    <i class="fa fa-paperclip text-primary"/>
                    <span class="fw-bold text-primary"><t t-out="translate('Files')"/></span>
                </div>
                <div class="card-body">
                    <t t-set="imageAtts" t-value="(state.order_data.order_attachment_ids || []).filter(a => a.mimetype and a.mimetype.startsWith('image/'))"/>
                    <t t-set="otherAtts" t-value="(state.order_data.order_attachment_ids || []).filter(a => !a.mimetype or !a.mimetype.startsWith('image/'))"/>
                    <div t-if="imageAtts.length" class="d-flex flex-wrap gap-2 mb-3">
                        <t t-foreach="imageAtts" t-as="att" t-key="att.id">
                            <a t-att-href="'/web/image/' + att.id" target="_blank">
                                <img t-att-src="'/web/image/' + att.id"
                                     class="rounded border"
                                     style="width:120px; height:90px; object-fit:cover;"/>
                            </a>
                        </t>
                    </div>
                    <div t-if="otherAtts.length" class="d-flex flex-wrap gap-2 mb-3">
                        <t t-foreach="otherAtts" t-as="att" t-key="att.id">
                            <a t-att-href="'/web/content/' + att.id + '?download=true'" target="_blank"
                               class="badge bg-light text-dark border text-decoration-none py-2 px-3">
                                <i class="fa fa-file me-1"/>
                                <t t-out="att.name"/>
                            </a>
                        </t>
                    </div>
                    <label class="text-primary" style="cursor:pointer;">
                        <i class="fa fa-plus-circle me-1"/>
                        <t t-out="translate('Attach files')"/>
                        <input type="file" class="d-none" multiple="multiple" t-on-change="onDirectFileSelect"/>
                    </label>
                </div>
            </div> -->
                <!-- Message Composer -->
                <div t-if="isInRfqList" class="card border-0 shadow-sm rounded-3 mt-4">
                    <div class="card-header bg-light d-flex align-items-center gap-2 py-2">
                        <i class="fa fa-comment text-primary"/>
                        <span class="fw-bold text-primary">
                            <t t-out="translate('Send a Message')"/>
                        </span>
                    </div>
                    <div class="card-body pb-2">
                        <textarea class="form-control mb-2"
                        t-ref="composerTextarea"
                        rows="3"
                        t-att-placeholder="translate('Write a message...')"
                        t-on-input="onComposerInput"/>
                        <!-- Selected file previews -->
                        <div t-if="state.composerFiles.length" class="d-flex flex-wrap gap-2 mb-2">
                            <t t-foreach="state.composerFiles" t-as="file" t-key="file_index">
                                <div class="d-flex align-items-center gap-1 border rounded px-2 py-1 bg-light">
                                    <img t-if="file.preview" t-att-src="file.preview"
                                     style="max-height:32px; max-width:40px; object-fit:cover;" class="rounded"/>
                                    <i t-else="" class="fa fa-paperclip text-muted"/>
                                    <small t-out="file.name" class="text-truncate" style="max-width:120px;"/>
                                    <button type="button" class="btn btn-sm p-0 ms-1 text-danger border-0 bg-transparent"
                                        t-on-click="() => removeFile(file_index)">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <!-- Actions row -->
                        <div class="d-flex justify-content-between align-items-center pt-1">
                            <!-- <label class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-0" style="cursor:pointer;">
                            <i class="fa fa-paperclip me-1"/>
                            <t t-out="translate('Attach')"/>
                            <input type="file" class="d-none" multiple="multiple" t-on-change="onFileSelect"/>
                        </label> -->
                            <button class="btn btn-sm btn-primary rounded-pill px-3"
                                t-on-click="postMessage"
                                t-att-disabled="!canSendMessage">
                                <i class="fa fa-paper-plane me-1"/>
                                <t t-out="state.isSendingMessage ? translate('Sending...') : translate('Send')"/>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Message History -->
                <div class="mt-4" t-if="state.order_data.message_ids.length">
                    <h5 class="mb-3">
                        <t t-out="translate('Messages')"/>
                    </h5>
                    <t t-foreach="state.order_data.message_ids" t-as="msg" t-key="msg.id">
                        <div class="d-flex mb-3 gap-2">
                            <div class="flex-grow-1 border rounded p-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong t-out="msg.author_id.name"/>
                                    <small class="text-muted" t-out="formatDate(msg.date)"/>
                                </div>
                                <!-- Message body (may contain HTML) -->
                                <div t-out="messageBody(msg.body)" t-if="msg.body"/>
                                <!-- Attachments -->
                                <t t-if="msg.attachment_ids and msg.attachment_ids.length">
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <t t-foreach="msg.attachment_ids" t-as="att" t-key="att.id">
                                            <t t-if="att.mimetype and att.mimetype.startsWith('image/')">
                                                <a t-att-href="'/web/image/' + att.id" target="_blank">
                                                    <img t-att-src="'/web/image/' + att.id"
                                                     class="img-thumbnail"
                                                     style="max-height:100px; max-width:150px; object-fit:cover;"/>
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <a t-att-href="'/web/content/' + att.id + '?download=true'"
                                               target="_blank"
                                               class="badge bg-light text-dark border text-decoration-none py-2 px-3">
                                                    <i class="fa fa-paperclip me-1"/>
                                                    <t t-out="att.name"/>
                                                </a>
                                            </t>
                                        </t>
                                    </div>
                                </t>
                                <!-- Regular field tracking changes (non-O2M) -->
                                <t t-set="regularTrackings" t-value="(msg.tracking_value_ids || []).filter((tv) => !tv.o2m_record_id)"/>
                                <ul class="mb-0 mt-2 small text-muted" t-if="regularTrackings.length">
                                    <t t-foreach="regularTrackings" t-as="tv" t-key="tv.id">
                                        <li>
                                            <span t-out="tv.old_value_char || (tv.old_value_float != null ? '$' + tv.old_value_float : '—')"/>
                                            <i class="fa fa-arrow-right mx-1"/>
                                            <span t-out="tv.new_value_char || (tv.new_value_float != null ? '$' + tv.new_value_float : '—')"/>
                                        </li>
                                    </t>
                                </ul>
                                <!-- O2M tracking changes grouped by field -->
                                <t t-foreach="(msg.o2mTrackings || [])" t-as="o2mGroup" t-key="o2mGroup.o2m_field_id">
                                    <div class="mt-2">
                                        <strong class="small" t-out="o2mGroup.o2m_field_description"/>
                                        <t t-foreach="o2mGroup.o2mTrackingCommands" t-as="cmd" t-key="cmd.id">
                                            <div class="ms-3 small text-muted">
                                                <span class="badge bg-secondary me-1" t-out="cmd.o2m_command"/>
                                                <span t-out="cmd.o2m_record_name"/>
                                                <ul class="list-unstyled mb-0 ms-2" t-if="cmd.o2mTrackingValues.length">
                                                    <t t-foreach="cmd.o2mTrackingValues" t-as="tv" t-key="tv.id">
                                                        <li>
                                                            <strong t-out="tv.changedField"/>:
                                                            <span t-out="tv.oldValue.value ?? '—'"/>
                                                            <i class="fa fa-arrow-right mx-1"/>
                                                            <span t-out="tv.newValue.value ?? '—'"/>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <t t-else="">
                <!-- Spinner loader -->
                <div class="text-center py-4">
                    <i class="fa fa-spinner fa-spin"/>
                    <t t-out="translate('Loading...')"/>
                </div>
            </t>
        </div>
    </t>
</templates>