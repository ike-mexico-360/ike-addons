<t t-name="ike_event_purchase.InvoiceList" owl="1">
  <div class="o_purchase_order_list">
    <t t-if="state.loading">
      <div class="text-center"><t t-out="translate('Loading...')"/></div>
    </t>
    <t t-else="">
      <!-- Header KPI -->
      <div t-if="state.showKpi" class="mb-4">

          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
              <div>
                  <h1 class="fw-bold display-5 mb-3">
                      Invoices
                  </h1>
                  <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary rounded-pill"
                      t-att-title="translate('Download invoice PDF')"
                      t-on-click="downloadInvoicesPdf">
                      <i class="fa fa-file-pdf-o me-1"/><t t-out="translate('Download PDF')"/>
                    </button>
                    <button class="btn btn-sm btn-success rounded-pill"
                      t-att-title="translate('Download invoice Excel')"
                      t-on-click="downloadInvoicesXlsx">
                      <i class="fa fa-file-excel-o me-1"/><t t-out="translate('Download Excel')"/>
                    </button>
                  </div>
              </div>

              <!-- <div class="card shadow-sm kpi-balance-card">
                  <div class="card-body py-2 px-3">
                      <div class="d-flex justify-content-between gap-5">
                          <span class="text-primary">Account balance</span>
                          <strong>
                              <t t-esc="formatCurrency(subtotalPaidAmount)"/>
                          </strong>
                      </div>

                      <div class="d-flex justify-content-between gap-5">
                          <span class="text-primary">Pending payment</span>
                          <strong>
                              <t t-esc="formatCurrency(pendingToPayAmount)"/>
                          </strong>
                      </div>
                  </div>
              </div> -->
          </div>

          <div class="row g-3">

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Total invoices</div>
                          <span class="kpi-value"><t t-out="totalInvoicesCount"/></span>
                      </div>
                  </div>
              </div>

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Subtotal invoices</div>
                          <span class="kpi-value"><t t-out="formatCurrency(subtotalInvoicesAmount)"/></span>
                      </div>
                  </div>
              </div>

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Paid Invoices</div>
                          <span class="kpi-value"><t t-out="paidInvoicesCount"/></span>
                      </div>
                  </div>
              </div>

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Paid Amount</div>
                          <span class="kpi-value"><t t-out="formatCurrency(subtotalPaidAmount)"/></span>
                      </div>
                  </div>
              </div>

              <div class="col">
                  <div class="card kpi-card h-100">
                      <div class="card-body text-center">
                          <div class="kpi-title">Pending Payment</div>
                          <span class="kpi-value"><t t-out="formatCurrency(pendingToPayAmount)"/></span>
                      </div>
                  </div>
              </div>
          </div>

      </div>

      <!-- Filters Bar -->
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body py-3">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-search me-1"/>
                <span>Invoice</span>
              </label>
              <input type="text"
                class="form-control form-control-sm rounded-pill"
                t-att-placeholder="translate('Buscar por factura...')"
                t-att-value="state.filters.reference"
                t-on-input="(ev) => this.onFilterChange('reference', ev.target.value)"/>
            </div>
            <!-- <div class="col-md-4">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-calendar me-1"/><t t-out="translate('Event')"/>
              </label>
              <input type="text"
                class="form-control form-control-sm rounded-pill"
                t-att-placeholder="translate('Buscar por evento...')"
                t-att-value="state.filters.event"
                t-on-input="(ev) => this.onFilterChange('event', ev.target.value)"/>
            </div> -->
            <div class="col-md-4">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-calendar-o me-1"/>
                Invoice date from
              </label>
              <input type="date"
                class="form-control form-control-sm rounded-pill"
                t-att-value="state.filters.dateFrom"
                t-on-change="(ev) => this.onFilterChange('dateFrom', ev.target.value)"/>
            </div>
            <div class="col-md-4">
              <label class="form-label small text-muted fw-semibold mb-1">
                <i class="fa fa-calendar-o me-1"/>
                Invoice date to
              </label>
              <input type="date"
                class="form-control form-control-sm rounded-pill"
                t-att-value="state.filters.dateTo"
                t-on-change="(ev) => this.onFilterChange('dateTo', ev.target.value)"/>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted fw-semibold mb-1">
                    <i class="fa fa-filter me-1"/>
                    <t t-out="translate('Status')"/>
                </label>

                <select
                    class="form-select form-select-sm rounded-pill"
                    t-att-value="state.filters.status"
                    t-on-change="(ev) => this.onFilterChange('status', ev.target.value)">
                    <option value="">All</option>
                    <option value="paid">Paid</option>
                    <option value="not_paid">Pending Payment</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <button class="btn btn-sm btn-outline-secondary rounded-pill w-100"
                t-att-title="translate('Clear filters')"
                t-on-click="clearFilters">
                <i class="fa fa-times me-1"/>
                Clear
              </button>
            </div>
          </div>
        </div>
      </div>
      <PaginationComponent pagination="pagination">
        <table class="table table-hover table-striped align-middle mb-0" style="border-collapse: separate; border-spacing: 0;">
          <thead>
            <tr class="active">
                <th>
                    <span class="d-none d-md-inline"><t t-out="translate('Factura')"/></span>
                    <span class="d-block d-md-none"><t t-out="translate('Ref.')"/></span>
                </th>
                <th>
                    <span class="d-none d-md-inline">Vendor Invoice</span>
                    <span class="d-block d-md-none">Vendor</span>
                </th>
                <th>
                    <span class="d-none d-md-inline">Invoice Date</span>
                    <span class="d-block d-md-none">Start Date</span>
                </th>
                <th>
                    <span class="d-none d-md-inline">Due Date</span>
                    <span class="d-block d-md-none">Due Date</span>
                </th>
                <th>
                    Amount Due
                </th>
                <th>
                    Status
                </th>
                <th class="text-center">
                    Comprobante de pago
                </th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="pagination.paginatedItems" t-as="invoice" t-key="invoice.id">
              <t t-set="invoiceStatus" t-value="getInvoiceStatus(invoice)"/>
              <tr>
                <!-- invoice -->
                <td>
                    <a t-attf-href="/my/invoices/#{invoice.id}?access_token=#{invoice.access_token}">
                        <t t-esc="invoice.name"/>
                    </a>
                </td>
                <!-- Supplier -->
                <td>
                    <t t-esc="invoice.partner_id.name"/>
                </td>
                <!-- date invoice -->
                <td>
                    <t t-esc="invoice.invoice_date"/>
                </td>
                <!-- date vue -->
                <td>
                    <t t-esc="invoice.invoice_date_due"/>
                </td>
                <!-- Total -->
                <td>
                    <t t-esc="formatCurrency(invoice.amount_total)"/>
                </td>
                <!-- stage -->
                <td>
                    <span class="badge rounded-pill"
                        t-att-class="invoiceStatus.cssClass"
                        t-esc="invoiceStatus.label"/>
                </td>
                <!-- Payment receipt -->
                <td class="text-center">
                    <a t-if="invoice.payment_state === 'paid' and invoice.has_payment_receipt"
                        class="btn btn-sm btn-outline-success rounded-pill"
                        t-att-href="'/my/invoices/' + invoice.id + '/payment_receipt'"
                        t-att-title="invoice.payment_receipt_filename || 'Descargar comprobante'">
                        <i class="fa fa-download me-1"/>
                        Descargar comprobante
                    </a>
                    <span t-else="">—</span>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </PaginationComponent>
    </t>
  </div>
</t>
