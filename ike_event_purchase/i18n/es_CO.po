#. module: ike_event_purchase
#: model:mail.template,body_html:ike_event_purchase.email_template_edi_purchase
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>)\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        Here is in attachment a request for quotation <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">P00015</span>\n"
"                        <t t-if=\"object.partner_ref\">\n"
"                            with reference: <t t-out=\"object.partner_ref or ''\">REF_XXX</t>\n"
"                        </t>\n"
"                        from <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                        <br/><br/>\n"
"                        If you have any questions, please do not hesitate to contact us.\n"
"                        <br/><br/>\n"
"                        Best regards,\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"                            <br/><br/>\n"
"                            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Apreciable <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>)\n"
"                        </t>\n"
"                        <br/><br/>\n"
"                        En este mensaje encontrará adjunta la solicitud de cotización <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">P00015</span>\n"
"                        <t t-if=\"object.partner_ref\">\n"
"                            con referencia: <t t-out=\"object.partner_ref or ''\">REF_XXX</t>\n"
"                        </t>\n"
"                        de <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                        <br/><br/>\n"
"                        No dude en contactarnos si tiene alguna pregunta.\n"
"                        <br/><br/>\n"
"                       Saludos cordiales,\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"                            <br/><br/>\n"
"                            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: ike_event_purchase
#: model:mail.template,body_html:ike_event_purchase.ike_event_purchase_proposal_dispute_ticket
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <table border=\"0\" width=\"100%\" cellpadding=\"0\" bgcolor=\"#ededed\" style=\"padding: 20px; background-color: #ededed; border-collapse:separate;\">\n"
"                    <tbody>\n"
"                    <!-- HEADER -->\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                        <table width=\"590\" border=\"0\" cellpadding=\"0\" bgcolor=\"#875A7B\" style=\"min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;\">\n"
"                            <tr>\n"
"                            <td valign=\"middle\">\n"
"                                <span style=\"font-size:20px; color:white; font-weight: bold;\">\n"
"                                <!-- {{object.name}} -->\n"
"                                <t t-out=\"object.name\"/>\n"
"                                </span>\n"
"                            </td>\n"
"\n"
"                            <td valign=\"middle\" align=\"right\">\n"
"                                <img t-attf-src=\"/logo.png?company={{ object.company_id.id }}\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" t-att-alt=\"object.company_id.name\"/>\n"
"                            </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <!-- CONTENT -->\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                        <table width=\"590\" border=\"0\" cellpadding=\"0\" bgcolor=\"#ffffff\" style=\"min-width: 590px; background-color: rgb(255, 255, 255); padding: 20px; border-collapse:separate;\">\n"
"                            <tbody>\n"
"                            <td valign=\"top\" style=\"font-family:Arial,Helvetica,sans-serif; color: #555; font-size: 14px;\">\n"
"                                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                                    The supplier\n"
"                                    <t t-out=\"object.partner_id.name\"/>\n"
"                                    has opened a dispute.\n"
"                                    <br/>\n"
"                                    <br/>\n"
"                                    Please review the changes.\n"
"                                    <br/>\n"
"                                    <br/>\n"
"                                </p>\n"
"                                <br/>\n"
"                                <br/>\n"
"                                <t t-set=\"orders\" t-value=\"object.sh_purchase_order_ids\"/>\n"
"                                <t t-if=\"env.context.get('actual_order', False)\">\n"
"                                    <t t-set=\"actual_order\" t-value=\"env.context.get('actual_order')\"/>\n"
"                                    <t t-set=\"orders\" t-value=\"orders.filtered(lambda x: x.id == actual_order)\"/>\n"
"                                </t>\n"
"                                <t t-foreach=\"orders\" t-as=\"order\">\n"
"                                    <table>\n"
"                                        <tbody>\n"
"                                            <tr><td colspan=\"5\" style=\"font-weight:bolder;text-align:center;\">Order <t t-out=\"order.name\"/></td></tr>\n"
"                                            <tr>\n"
"                                                <td style=\"font-weight:bolder;min-width:200px;text-align:left;\">Concept</td>\n"
"                                                <td style=\"font-weight:bolder;text-align:right;\">Price (Original)</td>\n"
"                                                <td style=\"font-weight:bolder;text-align:right;\">Quantity (Original)</td>\n"
"                                                <td style=\"font-weight:bolder;text-align:right;\">Price (Disputed)</td>\n"
"                                                <td style=\"font-weight:bolder;text-align:right;\">Quantity (Disputed)</td>\n"
"                                            </tr>\n"
"                                            <t t-foreach=\"order.order_line\" t-as=\"line\">\n"
"                                                <tr>\n"
"                                                    <td style=\"text-align:left;\"><t t-out=\"line.product_id.name\"/></td>\n"
"                                                    <td style=\"text-align:right;\"><t t-out=\"line.price_unit\"/></td>\n"
"                                                    <td style=\"text-align:right;\"><t t-out=\"line.product_uom_qty\"/></td>\n"
"                                                    <td style=\"text-align:right;\"><t t-out=\"line.x_price_unit_dispute\"/></td>\n"
"                                                    <td style=\"text-align:right;\"><t t-out=\"line.x_product_qty_dispute\"/></td>\n"
"                                                </tr>\n"
"                                            </t>\n"
"                                            <!-- <tr>\n"
"                                                <td colspan=\"5\">\n"
"                                                    <div style=\"display:flex;flex-direction:row;justify-content:center;gap:7px;\">\n"
"                                                        <a t-att-href=\"order.x_get_dispute_url(confirm_type='accept')\" target=\"_blank\"\n"
"                                                                style=\"background-color:#B3B2B1; padding:5px 10px; text-decoration:none; color:#ffffff; border-radius:5px; font-size:16px; margin-right:7px;\">\n"
"                                                            Approve dispute\n"
"                                                        </a>\n"
"                                                        <a t-att-href=\"order.x_get_dispute_url(confirm_type='decline')\" target=\"_blank\"\n"
"                                                                style=\"background-color:#ebebef; padding:5px 10px; text-decoration:none; color:#4a5573; border-radius:5px; font-size:16px\">\n"
"                                                            Reject dispute\n"
"                                                        </a>\n"
"                                                    </div>\n"
"                                                </td>\n"
"                                            </tr> -->\n"
"                                        </tbody>\n"
"                                    </table>\n"
"                                    <br/>\n"
"                                </t>\n"
"                            </td>\n"
"                            </tbody>\n"
"                        </table>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <!-- FOOTER -->\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                        <table width=\"590\" border=\"0\" cellpadding=\"0\" bgcolor=\"#875A7B\" style=\"min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;\">\n"
"                            <tr>\n"
"                            <td valign=\"middle\" align=\"left\" style=\"color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;\">\n"
"                                <t t-out=\"object.company_id.name\"/>\n"
"                                <br/>\n"
"                                <t t-out=\"object.company_id.phone or ''\"/>\n"
"                            </td>\n"
"                            <td valign=\"middle\" align=\"right\" style=\"color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;\">\n"
"                                <t t-if=\"object.company_id.email\">\n"
"                                <a t-attf-href=\"mailto:{{ object.company_id.email }}\" style=\"text-decoration:none; color: white;\">\n"
"                                    <t t-out=\"object.company_id.email\"/>\n"
"                                </a>\n"
"                                </t>\n"
"                                <br/>\n"
"                                <t t-if=\"object.company_id.website\">\n"
"                                <a t-attf-href=\"{{ object.company_id.website }}\" style=\"text-decoration:none; color: white;\">\n"
"                                    <t t-out=\"object.company_id.website\"/>\n"
"                                </a>\n"
"                                </t>\n"
"                            </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"                </div>\n"
"            "
msgstr ""

