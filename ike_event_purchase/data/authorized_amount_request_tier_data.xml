<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tier_definition_authorized_amount_request" model="tier.definition">
        <field name="name">Event amount increase authorization</field>
        <field name="model_id" ref="model_ike_event_authorized_amount_request"/>
        <field name="review_type">field</field>
        <field name="reviewer_field_id" ref="field_ike_event_authorized_amount_request__authorizer_id"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">30</field>
        <field name="notify_on_create" eval="True"/>
        <field name="notify_on_pending" eval="True"/>
        <field name="notify_on_accepted" eval="True"/>
        <field name="notify_on_rejected" eval="True"/>
        <field name="has_comment" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="tier_exception_authorized_amount_request" model="tier.validation.exception">
        <field name="name">CCC Leader may adjust requested amount</field>
        <field name="model_id" ref="model_ike_event_authorized_amount_request"/>
        <field name="field_ids" eval="[(6, 0, [ref('field_ike_event_authorized_amount_request__requested_amount')])]"/>
        <field name="group_ids" eval="[(6, 0, [ref('custom_master_catalog.custom_group_ccc_boss')])]"/>
        <field name="allowed_to_write_under_validation" eval="True"/>
        <field name="allowed_to_write_after_validation" eval="False"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
