<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_helpdesk_ticket_assignment_wizard_view_form" model="ir.ui.view">
        <field name="name">sh.helpdesk.ticket.assignment.wizard.view.form</field>
        <field name="model">sh.helpdesk.ticket.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignación">
                <group>
                    <field name="assigned_user_domain" invisible="1"/>
                </group>
                <notebook>
                    <page string="Tickets no asignados">
                        <group>
                            <field name="assigned_user_id"
                                string="Asignado a usuario"
                                required="1"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"
                                context="{
                                    'search_view_ref': 'custom_master_catalog.custom_view_users_search',
                                    'list_view_ref': 'custom_master_catalog.custom_view_users_list',
                                }"/>
                            <field name="stage_id"
                                string="Etapa"
                                required="1"
                                options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <field name="ticket_not_assign_ids"
                            options="{'no_open': True, 'no_create': True}"
                            context="{
                                'list_view_ref': 'ike_event_purchase.view_sh_helpdesk_ticket_assignment_list',
                                'search_view_ref': 'sh_all_in_one_helpdesk.sh_helpdesk_ticket_search_view'
                            }"/>
                    </page>
                    <page string="Tickets asignados">
                        <group>
                            <field name="assigned_user_ids"
                                widget="many2many_tags"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <field name="ticket_assign_ids" nolabel="1" readonly="1"
                            options="{'no_open': True, 'no_create': True}"
                            context="{'list_view_ref': 'ike_event_purchase.view_sh_helpdesk_ticket_assignment_list'}"/>
                    </page>
                </notebook>

                <footer>
                    <button string="Confirmar"
                        name="action_assignment_ticket"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sh_helpdesk_ticket_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Asignación</field>
        <field name="res_model">sh.helpdesk.ticket.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
