<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ike_event_confirm_costs_wizard_form" model="ir.ui.view">
        <field name="name">ike.event.confirm.costs.wizard.form</field>
        <field name="model">ike.event.confirm.costs.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="event_id" invisible="1"/>
                    <p>Are you sure you want to pay more than the event fee?</p>
                <footer>
                    <button name="action_confirm" string="Accept" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>