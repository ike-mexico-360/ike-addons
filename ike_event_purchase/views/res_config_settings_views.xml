<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase_inherit_ike_event_purchase" model="ir.ui.view">
        <field name="name">res_config_settings_view_form_purchase.inherit.ike_event_purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']/setting[@id='auto_receipt_reminder']" position="after">
                <setting id="x_time_for_automatic_purchase_generation" title="Time for automatic purchase generation" help="Waiting time to automatically approve the quote">
                    <field name="x_time_for_automatic_purchase_generation" class="oe_inline"/><span> hours</span>
                </setting>
                <setting id="x_default_purchase_project_id"
                            string="Default Purchase Project"
                            help="Technical: Default purchase project linked to the company at consolidate and send SAP data.">
                    <field name="x_default_purchase_project_id" options="{'no_open': True}"/>
                </setting>
            </xpath>
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Purchase Portal" name="x_purchase_portal_section">
                    <setting id="x_display_po_summary_portal"
                                string="Portal Summary Cards"
                                help="Display informative summary cards with total accumulated amounts in the supplier portal's purchase orders view.">
                        <field name="x_display_po_summary_portal"/>
                    </setting>
                </block>+
                <block title="Purchase Consolidation" name="x_purchase_consolidation_section">
                    <setting id="x_max_lines_per_po_at_consolidation"
                                string="Max lines per purchase order at consolidation"
                                help="Technical: Max lines per purchase order at consolidation. If the number of lines is greater than this value, the purchase order will be splitted.">
                        <field name="x_max_lines_per_po_at_consolidation" class="oe_inline"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
