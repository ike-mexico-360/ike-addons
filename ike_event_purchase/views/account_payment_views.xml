<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_disable_open" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.disable.open</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='partner_id'])[1]" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="(//field[@name='partner_id'])[2]" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>