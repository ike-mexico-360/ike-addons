<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_helpdesk_stage_time_group_view_list" model="ir.ui.view">
        <field name="name">custom.helpdesk.stage.time.group.list</field>
        <field name="model">custom.helpdesk.stage.time.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="stage_ids" widget="many2many_tags"/>
                <field name="max_wait_time"/>
                <field name="max_wait_time_unit"/>
            </list>
        </field>
    </record>

    <record id="custom_helpdesk_stage_time_group_view_form" model="ir.ui.view">
        <field name="name">custom.helpdesk.stage.time.group.form</field>
        <field name="model">custom.helpdesk.stage.time.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stage_ids" widget="many2many_tags"/>
                        <field name="max_wait_time"/>
                        <field name="max_wait_time_unit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="custom_helpdesk_stage_time_group_action" model="ir.actions.act_window">
        <field name="name">Accumulated time by stages</field>
        <field name="res_model">custom.helpdesk.stage.time.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="custom_helpdesk_stage_time_group_menu"
        name="Accumulated time by stages"
        parent="sh_all_in_one_helpdesk.helpdesk_config_menu"
        action="custom_helpdesk_stage_time_group_action"
        groups="sh_all_in_one_helpdesk.helpdesk_group_manager"
        sequence="12"
    />
</odoo>
