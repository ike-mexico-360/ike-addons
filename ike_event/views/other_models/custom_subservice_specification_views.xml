<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_subservice_specification_view_form_inherit_ike_event" model="ir.ui.view">
        <field name="name">custom.subservice.specification.view.form.inherit.ike.event</field>
        <field name="model">custom.subservice.specification</field>
        <field name="inherit_id" ref="custom_master_catalog.custom_subservice_specification_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vehicle_category_ids']" position="after">
                <field name="assignment_type_ids"
                    readonly="disabled"
                    widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="custom_subservice_specification_view_list_inherit_ike_event" model="ir.ui.view">
        <field name="name">custom.subservice.specification.view.list.inherit.ike.event</field>
        <field name="model">custom.subservice.specification</field>
        <field name="inherit_id" ref="custom_master_catalog.custom_subservice_specification_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vehicle_category_ids']" position="after">
                <field name="assignment_type_ids"
                    widget="many2many_tags"
                    optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>