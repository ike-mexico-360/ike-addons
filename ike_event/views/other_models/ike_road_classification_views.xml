<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ike.road.classification View List -->
    <record id="ike_road_classification_view_list" model="ir.ui.view">
        <field name="name">ike.road.classification.view.list</field>
        <field name="model">ike.road.classification</field>
        <field name="arch" type="xml">
            <list edit="0" create="1" delete="0">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View ike.road.classification form -->
    <record id="ike_road_classification_view_form" model="ir.ui.view">
        <field name="name">ike.road.classification.view.form</field>
        <field name="model">ike.road.classification</field>
        <field name="arch" type="xml">
            <form string="Ike Road Classification">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="o_form_label_required"/>
                        <h1>
                            <field name="name" placeholder="Name..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="country_id" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}" context="{'edit': False}"/>
                        <field name="state_id" required="1" options="{'no_create': True, 'no_open': True, 'no_edit': True}" context="{'edit': False}"/>
                    </group>
                    <notebook>
                        <page string="Destinations">
                            <field name="destination_ids"
                                context="{'default_column_1_id': id}">
                                <list editable="bottom">
                                    <field name="origin_id"
                                        readonly="1"
                                        column_invisible="1"
                                        force_save="1"
                                        options="{'no_create': True, 'no_open': True}"/>
                                   <field name="destination_id"
                                        options="{'no_create': True, 'no_open': True}"
                                        domain="[
                                            ('id', '!=', parent.id),
                                        ]"/>
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View ike.road.classification search -->
    <record id="ike_road_classification_view_search" model="ir.ui.view">
        <field name="name">ike.road.classification.view.search</field>
        <field name="model">ike.road.classification</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ike.road.classification -->
    <record id="action_ike_road_classification" model="ir.actions.act_window">
        <field name="name">Ike Road Classification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ike.road.classification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
