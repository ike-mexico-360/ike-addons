<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEARCH -->
    <record id="view_ike_service_input_medical_consultation_search" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.consultation.search</field>
        <field name="model">ike.service.input.medical.consultation</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id"/>
            </search>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_ike_service_input_medical_consultation_list" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.consultation.list</field>
        <field name="model">ike.service.input.medical.consultation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="event_id"/>
            </list>
        </field>
    </record>

    <!-- REGULAR FORM -->
    <record id="view_ike_service_input_medical_consultation_form" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.consultation.form</field>
        <field name="model">ike.service.input.medical.consultation</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet class="ike_sheet">
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group invisible="0">
                        <field name="name"/>
                        <field name="step_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SCREEN FORM -->
    <record id="view_ike_service_input_medical_consultation_screen_form" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.consultation.screen.form</field>
        <field name="model">ike.service.input.medical.consultation</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form js_class="ike_service_input_screen_form">
                <sheet class="ike-sheet">
                    <group invisible="0">
                        <field name="name"/>
                        <field name="stage_ref"/>
                        <field name="step_number"/>
                        <field name="event_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_ike_service_input_medical_consultation" model="ir.actions.act_window">
        <field name="name">Service Input Vial Medical Consultation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ike.service.input.medical.consultation</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'list', 'view_id': ref('view_ike_service_input_medical_consultation_list')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('view_ike_service_input_medical_consultation_form')})]" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
