<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ike.service.input.medical View List -->
    <record id="view_ike_service_input_medical_list" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.list</field>
        <field name="model">ike.service.input.medical</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_id"/>
            </list>
        </field>
    </record>

    <!-- View ike.service.input.medical form -->
    <record id="view_ike_service_input_medical_form" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.form</field>
        <field name="model">ike.service.input.medical</field>
        <field name="arch" type="xml">
            <form string="Service Input Medical">
                <!-- <header>
                    <field name="stage_id" widget="statusbar_duration" options="{'clickable': 1, 'fold_field': 'fold'}" />
                </header> -->
                <sheet>
                    <div class="oe_title">
                        <label for="event_id"/>
                        <h1>
                            <field name="event_id" placeholder="Event..." readonly="1"/>
                        </h1>
                    </div>
                    <group invisible="0">
                        <field name="name"/>
                        <field name="step_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Input Screen -->
    <record id="view_ike_service_input_medical_screen_form" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.screen.form</field>
        <field name="model">ike.service.input.medical</field>
        <field name="mode">primary</field>
        <field eval="100" name="priority"/>
        <field name="inherit_id" ref="ike_event.view_ike_service_input_medical_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//form" position="attributes">
                    <attribute name="js_class">ike_service_input_screen_form</attribute>
                </xpath>
                <xpath expr="//group" position="after">
                    <group name="user_service_data" invisible="not sections.get('user_service_data', False)">
                        <group string="Person Data" name="person_data" class="ike-group">

                        </group>
                        <group>

                        </group>
                    </group>
                    <group name="location_data" invisible="not sections.get('user_service_data', False)">
                        <group string="Location Data" name="location_data" class="ike-group">

                        </group>
                        <group>

                        </group>
                    </group>
                    <group name="product_data" invisible="not sections.get('product_data', False)">
                        <group string="Concepts" colspan="2">
                            <field name="event_supplier_number" invisible="0"/>
                            <field name="service_product_ids" widget="ike_section_and_note_field_o2m" nolabel="1" colspan="2"
                                    context="{
                                        'list_view_ref': 'ike_event.ike_event_product_list_view',
                                        'default_supplier_number': event_supplier_number,
                                        'default_event_id': event_id,
                                        'from_internal': True,
                                    }"
                                    options="{
                                        'field_columns': ['product_id'],
                                        'delete_condition_field': 'mandatory',
                                    }"/>
                        </group>
                    </group>
                    <group invisible="not sections.get('user_sub_service_data')">
                        <group>
                            <field name="products_count" invisible="1"/>
                        </group>
                        <div class="d-flex justify-content-end gap-1">
                            <button string="Return" class="btn-secondary o_discard"
                                    special="cancel" data-hotkey="x" />
                            <!-- <button string="Continue" class="btn-primary o_save"
                                    special="save" data-hotkey="s"
                                    invisible="products_count == 0" /> -->
                            <widget name="ike_button_checkbox"
                                className="btn btn-primary"
                                special="save"
                                string="Continue"
                                confirm="Are you sure you added all the concepts?"
                                readonly="products_count == 0"
                                hotkey="s"/>
                        </div>
                    </group>
                    <group>
                        <div class="d-flex justify-content-end gap-1">
                            <button string="Return" class="btn-secondary o_discard"
                                    special="cancel" data-hotkey="x"/>
                            <button string="Continue" class="btn-primary o_save"
                                    special="save" data-hotkey="s" />
                        </div>
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <!-- View ike.service.input.medical search -->
    <record id="view_ike_service_input_medical_search" model="ir.ui.view">
        <field name="name">view.ike.service.input.medical.search</field>
        <field name="model">ike.service.input.medical</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_id"/>
            </search>
        </field>
    </record>

    <!-- Action ike.service.input.medical -->
    <record id="action_ike_service_input_medical" model="ir.actions.act_window">
        <field name="name">Service Input Medical</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ike.service.input.medical</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
