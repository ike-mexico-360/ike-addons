<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ike.event.supplier.evaluation search -->
    <record id="view_ike_event_supplier_evaluation_search" model="ir.ui.view">
        <field name="name">view.ike.event.supplier.evaluation.search</field>
        <field name="model">ike.event.supplier.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- View ike.event.supplier.evaluation View List -->
    <record id="view_ike_event_supplier_evaluation_list" model="ir.ui.view">
        <field name="name">view.ike.event.supplier.evaluation.list</field>
        <field name="model">ike.event.supplier.evaluation</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reevaluation"/>
            </list>
        </field>
    </record>

    <!-- View ike.event.supplier.evaluation form -->
    <record id="view_ike_event_supplier_evaluation_form" model="ir.ui.view">
        <field name="name">view.ike.event.supplier.evaluation.form</field>
        <field name="model">ike.event.supplier.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="reevaluation"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action ike.event.supplier.evaluation -->
    <record id="action_ike_event_supplier_evaluation" model="ir.actions.act_window">
        <field name="name">Event Supplier Evaluation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ike.event.supplier.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
