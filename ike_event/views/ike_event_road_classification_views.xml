<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ike_event_road_classification_view_list" model="ir.ui.view">
        <field name="name">ike.event.road.classification.view.list</field>
        <field name="model">ike.event.road.classification</field>
        <field name="arch" type="xml">
            <list delete="1" edit="0" duplicate="0">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="ike_event_road_classification_view_form" model="ir.ui.view">
        <field name="name">ike.event.road.classification.view.form</field>
        <field name="model">ike.event.road.classification</field>
        <field name="arch" type="xml">
            <form delete="0" duplicate="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-secondary" invisible="not disabled or not active" />
                    <group>
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="disabled"/>
                        </h1>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ike_event_road_classification_view_search" model="ir.ui.view">
        <field name="name">ike.event.road.classification.view.search</field>
        <field name="model">ike.event.road.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Disabled" name="filter_disabled" domain="[('disabled', '=', True)]"/>
                <filter string="Enabled" name="filter_enabled" domain="[('disabled', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ike_event_road_classification_view_action" model="ir.actions.act_window">
        <field name="name">Event road classification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ike.event.road.classification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_enabled': 1}</field>
    </record>
</odoo>
