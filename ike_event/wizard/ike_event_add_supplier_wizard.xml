<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ike_event_add_supplier_wizard_view_form" model="ir.ui.view">
        <field name="name">ike.event.add.supplier.wizard.view.form</field>
        <field name="model">ike.event.add.supplier.wizard</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <group>
                        <field name="event_id" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="supplier_id" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="supplier_number" invisible="1"/>
                        <field name="aux_truck_id" domain="aux_truck_domain" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="aux_truck_domain" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_create_event_supplier_link" string="Add Supplier" type="object" class="btn-primary"/>
                        <button string="Close" type="object" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
