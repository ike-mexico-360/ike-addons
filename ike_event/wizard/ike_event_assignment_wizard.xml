<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ike_event_assignment_wizard_view_form" model="ir.ui.view">
        <field name="name">ike.event.assignment.wizard.view.form</field>
        <field name="model">ike.event.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <group>
                    <field name="assigned_user_domain" invisible="1"/>
                </group>
                <notebook>
                    <page string="Events not assigned">
                        <group>
                            <field name="assigned_user_id"
                                required="not reassigned_user_id"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"
                                context="{
                                    'search_view_ref': 'custom_master_catalog.custom_view_users_search',
                                    'list_view_ref': 'custom_master_catalog.custom_view_users_list',
                                }"/>
                        </group>
                        <field name="event_not_assign_ids"
                            options="{'no_open': True, 'no_create': True}"
                            context="{
                                'list_view_ref': 'ike_event.view_ike_event_assignment_list',
                                'search_view_ref': 'ike_event.view_ike_event_search'
                            }"/>
                    </page>
                    <page string="Events assign">
                        <group>
                            <field name="assigned_user_ids"
                                widget="many2many_tags"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <field name="event_assign_ids" nolabel="1" readonly="1"
                            options="{'no_open': True, 'no_create': True}"
                            context="{'list_view_ref': 'ike_event.view_ike_event_assignment_list'}"/>
                    </page>
                    <page string="Reassign">
                        <group>
                            <field name="reassigned_user_id"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"
                                context="{
                                    'search_view_ref': 'custom_master_catalog.custom_view_users_search',
                                    'list_view_ref': 'custom_master_catalog.custom_view_users_list',
                                }"/>
                        </group>
                        <field name="event_reassignment_ids"
                            domain="[
                                ('assigned_user_id', '!=', False),
                                ('assigned_user_id', '!=', uid),
                                ('stage_ref', 'in', ['verifying', 'cancel_verifying'])
                            ]"
                            options="{'no_open': True, 'no_create': True}"
                            context="{
                                'list_view_ref': 'ike_event.custom_event_reassignment_list',
                                'search_view_ref': 'ike_event.view_ike_event_search'
                            }"/>
                    </page>
                </notebook>

                <footer>
                    <button string="Confirm"
                        name="action_assignment_event"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Assignment</field>
        <field name="res_model">ike.event.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="custom_event_reassignment_list" model="ir.ui.view">
        <field name="name">custom.event.reassignment.list</field>
        <field name="model">ike.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" duplicate="false" delete="false">
                <field name="name"/>
                <field name="assigned_user_id" string="Assigned user"/>
                <field name="service_id"/>
                <field name="sub_service_id"/>
                <field name="event_type_id"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="custom_event_assignment_cds_wizard_view_form" model="ir.ui.view">
        <field name="name">custom.event.assignment.cds.wizard.view.form</field>
        <field name="model">custom.event.assignment.cds.wizard</field>
        <field name="arch" type="xml">
            <form string="CDS Event Assignment">
                <group>
                    <field name="assigned_user_domain" invisible="1"/>
                </group>
                <notebook>
                    <page string="Events not assigned">
                        <group>
                            <field name="assigned_user_id"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"
                                context="{
                                    'search_view_ref': 'custom_master_catalog.custom_view_users_search',
                                    'list_view_ref': 'custom_master_catalog.custom_view_users_list',
                                }"/>
                        </group>
                        <field name="event_not_assign_ids"
                            options="{'no_open': True, 'no_create': True}"
                            context="{
                                'list_view_ref': 'ike_event.view_ike_event_assignment_list',
                                'search_view_ref': 'ike_event.view_ike_event_search'
                            }"/>
                    </page>
                    <page string="Events assign">
                        <group>
                            <field name="assigned_user_ids"
                                widget="many2many_tags"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"/>
                        </group>
                        <field name="event_assign_ids" nolabel="1" readonly="1"
                            options="{'no_open': True, 'no_create': True}"
                            context="{'list_view_ref': 'ike_event.view_ike_event_assignment_list'}"/>
                    </page>
                    <page string="Reassign">
                        <group>
                            <field name="reassigned_user_id"
                                domain="assigned_user_domain"
                                options="{'no_open': True, 'no_create': True}"
                                context="{
                                    'search_view_ref': 'custom_master_catalog.custom_view_users_search',
                                    'list_view_ref': 'custom_master_catalog.custom_view_users_list',
                                }"/>
                        </group>
                        <field name="event_reassignment_ids"
                            domain="[
                                ('assigned_user_id', '!=', False),
                                ('assigned_user_id', '!=', uid),
                                ('stage_ref', 'in', ['draft', 'capturing', 'searching', 'assigned', 'in_progress'])
                            ]"
                            options="{'no_open': True, 'no_create': True}"
                            context="{
                                'list_view_ref': 'ike_event.custom_event_reassignment_list',
                                'search_view_ref': 'ike_event.view_ike_event_search'
                            }"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Confirm"
                        name="action_assignment_event"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_custom_event_assignment_cds_wizard" model="ir.actions.act_window">
        <field name="name">CDS Event Assignment</field>
        <field name="res_model">custom.event.assignment.cds.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
