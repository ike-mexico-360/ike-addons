<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduler for Event Close -->
        <record id="ike_event_automatic_close_events_cron" model="ir.cron">
            <field name="name">Automatically close events 'cancelled_posterior' and 'completed'</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="ike_event.model_ike_event"/>
            <field name="code">model._x_cron_automatic_close_events()</field>
            <field name="state">code</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <!-- Scheduler for Event Alarm-->
        <record id="ike_event_notify_scheduled" model="ir.cron">
            <field name="name">Ike Event: Scheduled Notification</field>
            <field name="model_id" ref="model_ike_event"/>
            <field name="state">code</field>
            <field name="code">model._notify_scheduled()</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
    <!-- Manual migration of stage fields to ike.event.supplier.time.log.
        Inactive: run from Settings > Technical > Scheduled Actions > "Run Manually". -->
    <record id="ir_cron_migrate_supplier_time_log" model="ir.cron">
        <field name="name">IKE: Migrate stage fields to Time Log</field>
        <field name="model_id" ref="model_ike_event_supplier_time_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_migrate_legacy_stage_fields()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
