<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Allow CCC roles to enter the Suppliers application only to consult
         confirmed cost matrices. Child menus keep their own group restrictions. -->
    <record id="custom_master_catalog.menu_suppliers" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('custom_master_catalog.custom_group_ccc_analyst')),
            (4, ref('custom_master_catalog.custom_group_ccc_coordinator')),
            (4, ref('custom_master_catalog.custom_group_ccc_boss'))
        ]"/>
    </record>

    <record id="custom_master_catalog.res_partner_menu_suppliers" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (4, ref('custom_master_catalog.custom_group_ccc_analyst')),
            (4, ref('custom_master_catalog.custom_group_ccc_coordinator')),
            (4, ref('custom_master_catalog.custom_group_ccc_boss'))
        ]"/>
    </record>

    <menuitem id="custom_supplier_cost_matrix_ccc_menu"
        name="Cost Matrix"
        parent="custom_master_catalog.res_partner_menu_suppliers"
        action="custom_supplier_cost_matrix_line_action"
        groups="custom_master_catalog.custom_group_ccc_analyst,custom_master_catalog.custom_group_ccc_coordinator,custom_master_catalog.custom_group_ccc_boss"
        sequence="30"/>

    <menuitem id="custom_supplier_cost_matrix_configuration_menu"
        parent="custom_master_catalog.res_partner_menu_suppliers"
        action="custom_supplier_upload_cost_matrix_configuration_action"
        name="Supplier Cost Matrix Configuration"
        groups="base.group_system,custom_master_catalog.custom_group_contact_admin_supplier,custom_master_catalog.custom_group_supplier_admin_system,custom_master_catalog.custom_group_supplier_procurement,custom_master_catalog.custom_group_supplier_contralory,custom_master_catalog.custom_group_supplier_support,custom_master_catalog.custom_group_bi_queries"
        sequence="25"/>

    <menuitem id="custom_general_menu_root"
        name="General"
        parent="custom_master_catalog.configuration_menu_root"
        groups="base.group_system,custom_master_catalog.custom_group_supplier_admin_system,custom_master_catalog.custom_group_supplier_contralory,custom_master_catalog.custom_group_supplier_support,custom_master_catalog.custom_group_bi_queries"
        sequence="20">
        <menuitem id="custom_supplier_cost_product_schedule_menu"
            name="Opening Hours"
            action="custom_supplier_cost_product_schedule_action"
            groups="base.group_system,custom_master_catalog.custom_group_supplier_admin_system,custom_master_catalog.custom_group_supplier_contralory,custom_master_catalog.custom_group_supplier_support,custom_master_catalog.custom_group_bi_queries"
            sequence="5"/>
        <menuitem id="custom_supplier_cost_matrix_line_action_menu"
            name="Matrix Cost Confirmed"
            action="custom_supplier_cost_matrix_line_action"
            groups="base.group_system"
            sequence="15"/>
        <menuitem id="custom_holidays_action_menu"
            name="Holidays"
            action="custom_master_catalog.action_custom_holidays"
            groups="base.group_system"
            sequence="25"/>
    </menuitem>

    <record id="custom_supplier_cost_matrix_configuration_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(3, ref('custom_master_catalog.custom_group_supplier_procurement'))]"/>
    </record>
</odoo>
