<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_dian_invoices" name="Portal DIAN Invoices Integration" inherit_id="ike_event_portal.portal_my_home_ike_events">
        <xpath expr="//div[@id='portal_ike_events_services']" position="inside">
            <t t-call="portal.portal_docs_entry" t-if="request.env.user.has_group('ike_event_portal.custom_group_portal_finance')">
                <t t-set="title">SAT Invoices</t>
                <t t-set="url" t-value="'/provider/portal/invoice/dian'"/>
                <t t-set="text">Electronic invoicing documents</t>
                <t t-set="icon" t-value="'/purchase/static/src/img/calculator.svg'"/>
            </t>
        </xpath>
    </template>

     <template id="portal_my_home_menu_invoice_custom" inherit_id="account.portal_my_home_menu_invoice">
        <xpath expr="//a[@t-if='invoice']" position="attributes">
            <attribute name="t-attf-href">
                /my/provider/invoices
            </attribute>
        </xpath>
    </template>

     <template id="portal_invoice_page_remove_chatter" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[@id='invoice_communication']" position="replace"/>
    </template>

    <template id="portal_record_sidebar_remove_odoo" inherit_id="portal.portal_record_sidebar">
        <xpath expr="//div[contains(@class, 'text-muted')]" position="replace">
        </xpath>
    </template>
</odoo>
