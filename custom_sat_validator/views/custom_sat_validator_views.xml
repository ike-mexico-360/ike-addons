<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search view -->
    <record id="view_custom_sat_validator_search" model="ir.ui.view">
        <field name="name">custom.sat.validator.view.search</field>
        <field name="model">custom.sat.validator</field>
        <field name="arch" type="xml">
            <search string="Search SAT Validator">
                <field name="name" string="Reference"/>
                <field name="purchase_id"/>

                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Purchase Order" name="group_by_purchase_id" context="{'group_by': 'purchase_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List view -->
    <record id="view_custom_sat_validator_list" model="ir.ui.view">
        <field name="name">custom.sat.validator.view.list</field>
        <field name="model">custom.sat.validator</field>
        <field name="arch" type="xml">
            <list delete="0">
                <field name="name"/>
                <field name="state"/>
                <field name="purchase_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="ccustom_sat_validator_view_form" model="ir.ui.view">
        <field name="name">custom.sat.validator.view.form</field>
        <field name="model">custom.sat.validator</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_and_validate_invoice_xml"
                            string="Validate in SAT"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['done']"/>
                    <button name="action_force_validate_xml_from_sat"
                            string="Validate (Only XML in SAT)"
                            type="object"
                            groups="base.group_no_one"
                            class="oe_highlight"/>
                    <button name="action_draft"
                            string="Return draft"
                            type="object"
                            groups="base.group_no_one"
                            class="oe_highlight"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field
                                name="purchase_id"
                                options="{'no_create': True}"
                                readonly="state == 'done'"
                                domain="[('state', 'in', ['purchase', 'done'])]"/>
                        </group>
                        <group>
                        </group>
                    </group>

                    <notebook>
                        <page string="Received Document Packages (XML, PDF, CP)" name="received_documents">
                            <field name="document_line_ids" readonly="state == 'done'">
                                <list create="1" edit="1" delete="1"
                                      decoration-danger="line_state == 'xml_error'"
                                      decoration-success="line_state == 'validated'">

                                    <field name="sequence" widget="handle"/>

                                    <field name="name" placeholder="e.g. Invoice Jan-01"/>

                                    <field name="xml_filename" column_invisible="1"/>
                                    <field
                                        name="xml_file"
                                        filename="xml_filename"
                                        widget="binary"
                                        string="XML"
                                        options="{'accepted_file_extensions': '.xml'}"/>

                                    <field name="pdf_filename" column_invisible="1"/>
                                    <field
                                        name="pdf_file"
                                        filename="pdf_filename"
                                        widget="binary"
                                        string="PDF"
                                        options="{'accepted_file_extensions': '.pdf'}"/>

                                    <field name="carta_porte_filename" column_invisible="1"/>
                                    <field
                                        name="carta_porte_file"
                                        filename="carta_porte_filename"
                                        widget="binary"
                                        string="Carta Porte"/>

                                    <field name="sat_uuid" string="UUID" optional="show"/>
                                    <field name="emisor_rfc" string="Vendor RFC" optional="hide"/>
                                    <field name="total_amount" string="Total XML" sum="Total Invoiced Amount"/>

                                    <field name="sat_status" widget="badge"
                                           decoration-success="sat_status == 'Vigente'"
                                           decoration-danger="sat_status in ['Cancelado', 'Error']"
                                           decoration-warning="sat_status == 'No Encontrado'"/>

                                    <field name="line_state" widget="badge"
                                           decoration-info="line_state == 'draft'"
                                           decoration-danger="line_state == 'xml_error'"
                                           decoration-success="line_state == 'validated'"/>

                                    <field name="invoice_id" string="Generated Bill" readonly="1"/>

                                    <field name="line_validation_log" string="Logs / Errors" optional="hide"/>
                                </list>
                                <form string="Document Package Details">
                                    <header>
                                        <field name="line_state" widget="statusbar" statusbar_visible="draft,xml_error,validated"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_title">
                                            <label for="name" class="oe_edit_only"/>
                                            <h1><field name="name" readonly="1"/></h1>
                                        </div>
                                        <group string="Files Upload">
                                            <group>
                                                <field name="xml_filename" invisible="1"/>
                                                <field
                                                    name="xml_file"
                                                    filename="xml_filename"
                                                    widget="binary"
                                                    string="XML File"
                                                    options="{'accepted_file_extensions': '.xml'}"/>
                                                <field name="pdf_filename" invisible="1"/>
                                                <field
                                                    name="pdf_file"
                                                    filename="pdf_filename"
                                                    widget="binary"
                                                    string="PDF File"
                                                    options="{'accepted_file_extensions': '.pdf'}"/>
                                            </group>
                                            <group>
                                                <field name="carta_porte_filename" invisible="1"/>
                                                <field
                                                    name="carta_porte_file"
                                                    filename="carta_porte_filename"
                                                    widget="binary"
                                                    string="Carta Porte File"/>
                                            </group>
                                        </group>

                                        <group string="SAT &amp; Financial Audit Results">
                                            <group>
                                                <field name="sat_uuid"/>
                                                <field name="subtotal_amount" widget="monetary"/>
                                                <field name="total_amount" widget="monetary"/>
                                                <field name="sat_status" widget="badge"
                                                    decoration-success="sat_status == 'Vigente'"
                                                    decoration-danger="sat_status in ['Cancelado', 'Error']"/>
                                            </group>
                                            <group>
                                                <field name="emisor_rfc"/>
                                                <field name="receptor_rfc"/>
                                                <field name="invoice_id" readonly="1" options="{'no_open': False}"/>
                                            </group>
                                        </group>

                                        <!-- NOTEBOOK WITH XML LINES & LOGS -->
                                        <notebook>
                                            <page string="XML Concept Lines" name="xml_lines">
                                                <field name="xml_line_ids" readonly="line_state == 'validated'">
                                                    <list editable="bottom">
                                                        <field name="company_currency_id" column_invisible="True"/>
                                                        <field name="product_name"/>
                                                        <field name="quantity"/>
                                                        <field name="price_unit" widget="monetary"/>
                                                        <field name="subtotal" widget="monetary"/>
                                                        <field name="tax_ids" widget="many2many_tags"/>
                                                        <field name="purchase_order_line_ids" widget="many2many_tags"/>
                                                    </list>
                                                </field>
                                            </page>
                                            <page string="Execution Logs" name="execution_logs" invisible="not line_validation_log">
                                                <group>
                                            <field name="line_validation_log"
                                                readonly="1"
                                                nolabel="1"
                                                class="text-success font-monospace"
                                                invisible="line_state != 'validated'"/>

                                            <field name="line_validation_log"
                                                readonly="1"
                                                nolabel="1"
                                                class="text-danger font-monospace"
                                                invisible="line_state == 'validated'"/>
                                        </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_sat_validator" model="ir.actions.act_window">
        <field name="name">SAT CFDI Validator</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">custom.sat.validator</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_custom_sat_validator_search"/>
        <field name="domain">[]</field>
        <field name="context"></field>
    </record>

</odoo>