<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ike_event_portal_my_purchase_order_sat" name="SAT Purchase Order Detail" inherit_id="purchase.portal_my_purchase_order">
        <xpath expr="//a[@id='print_invoice_report']" position="after">

            <!-- Custom Compact & Drag/Drop Styles -->
            <style t-out="''">
                .sat-compact-table {
                    border-collapse: collapse !important;
                    margin-bottom: 0 !important;
                    table-layout: fixed !important;
                    width: 100% !important;
                }

                .sat-compact-table tr {
                    box-sizing: border-box !important;
                }

                .sat-compact-table th,
                .sat-compact-table td {
                    padding-top: 4px !important;
                    padding-bottom: 4px !important;
                    padding-left: 6px !important;
                    padding-right: 6px !important;
                    vertical-align: middle !important;
                    box-sizing: border-box !important;
                    white-space: nowrap !important;
                    overflow: hidden !important;
                    text-overflow: ellipsis !important;
                    line-height: 1.2 !important;
                    border-bottom: 1px solid #dee2e6 !important;
                }

                .sat-compact-table input[type="checkbox"].form-check-input {
                    margin: 0 !important;
                    vertical-align: middle !important;
                    height: 14px !important;
                    width: 14px !important;
                }

                tr.xml-drag-item {
                    cursor: grab;
                    user-select: none;
                }
                tr.xml-drag-item:active {
                    cursor: grabbing;
                }
                tr.xml-drag-item.dragging {
                    opacity: 0.4;
                    background-color: #eaf1f9 !important;
                }
                tr.xml-drop-slot.drag-over {
                    background-color: #d0e1f9 !important;
                    outline: 1px dashed #2f6fb0 !important;
                }
            </style>

            <!-- SAT Validator Portal Control Panel -->
            <t t-set="supplier_rel"
               t-value="request.env['res.partner.supplier_users.rel'].sudo().search([('user_id', '=', request.env.user.id)], limit=1)"/>

            <div t-if="order.state in ('purchase', 'done') and (request.env.user.has_group('base.group_system') or (request.env.user.has_group('ike_event_portal.custom_group_portal_finance') and supplier_rel and supplier_rel.supplier_id.x_advanced_portal))" class="d-grid gap-2 mt-3" id="sat_validator_portal_root">

                <div class="small fw-bold text-muted text-uppercase border-bottom pb-1 mb-1">
                    <i class="fa fa-shield me-1"/> SAT CFDI Validator
                </div>

                <button type="button" class="btn btn-ike-force btn-sm text-start shadow-sm" data-bs-toggle="modal" data-bs-target="#modal_upload_sat_packages" style="background-color: #2F6FB0 !important; border-color: #2F6FB0 !important; color: #ffffff !important;">
                    <i class="fa fa-upload me-2"/> Import New Packages
                </button>

                <button type="button" class="btn btn-outline-secondary btn-sm text-start shadow-sm text-dark bg-white" data-bs-toggle="modal" data-bs-target="#modal_history_sat_packages">
                    <i class="fa fa-list-alt me-2" style="color: #2F6FB0;"/> View Uploaded Log
                </button>

                <div id="sat_xml_validation_result" class="mt-1 small"/>
            </div>

            <!-- MODAL: UPLOAD SAT PACKAGES QUEUE -->
            <div class="modal fade" id="modal_upload_sat_packages" tabindex="-1" aria-hidden="true" data-bs-focus="false">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 95% !important;">
                    <div class="modal-content">
                        <div class="modal-header py-2" style="background-color: #F7F9FC !important; border-bottom: 1px solid #DCE3EB !important;">
                            <h6 class="modal-title m-0 fw-bold" style="color: #2C3E66 !important;">
                                <i class="fa fa-cloud-upload me-2" style="color: #2F6FB0 !important;"/> Import &amp; Match SAT CFDI Document
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" tabindex="-1"/>
                        </div>
                        <div class="modal-body p-3">
                            <!-- Section 1: Upload Controls -->
                            <div class="row g-2 p-2 border rounded align-items-end mb-2" style="background-color: #F7F9FC !important; border-color: #E1E7F0 !important;">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-1" style="color: #2F6FB0 !important;">CFDI XML File *</label>
                                    <input type="file" id="portal_sat_xml_file" class="form-control form-control-sm" accept=".xml" required="required"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1" style="color: #2F6FB0 !important;">Vendor Bill PDF *</label>
                                    <input type="file" id="portal_sat_pdf_file" class="form-control form-control-sm" accept=".pdf"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1" style="color: #2F6FB0 !important;">Carta Porte (Optional)</label>
                                    <input type="file" id="portal_sat_cp_file" class="form-control form-control-sm" accept=".xml,.pdf"/>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" id="process_sat_xml_btn" class="btn btn-ike-force btn-sm w-100" t-att-data-order-id="order.id" style="background-color: #2F6FB0 !important; border-color: #2F6FB0 !important; color: #ffffff !important;">
                                        <i class="fa fa-cogs me-1"/> Process XML
                                    </button>
                                </div>
                            </div>

                            <!-- Top Alert Container -->
                            <div id="sat_process_xml_alert" class="alert py-2 mb-2 d-none small" role="alert"></div>

                            <!-- Section 2: Split Tables Layout -->
                            <div class="row g-2">
                                <!-- Left Column: Purchase Order Lines -->
                                <div class="col-md-6">
                                    <div class="card shadow-sm border">
                                        <div class="card-header py-1 px-2" style="background-color: #EAF1F9 !important;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="fw-bold text-uppercase small" style="color: #2C3E66 !important; font-size: 0.75rem;">
                                                    <i class="fa fa-shopping-cart me-1"/> Purchase Order Lines
                                                </span>
                                                <span class="badge bg-secondary" style="font-size: 0.65rem;">Matched Lines</span>
                                            </div>
                                        </div>
                                        <div class="table-responsive" style="min-height: 180px;">
                                            <table class="table table-hover align-middle m-0 table-sm sat-compact-table">
                                                <thead>
                                                    <tr class="small border-bottom" style="background-color: #F8FAFC !important;">
                                                        <th style="width: 40%;">PO Product</th>
                                                        <th style="width: 25%;">Event</th>
                                                        <th class="text-end" style="width: 10%;">Qty</th>
                                                        <th class="text-end" style="width: 17%;">PO Subtotal</th>
                                                        <th class="text-center" style="width: 8%;">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="local_sat_po_tbody">
                                                    <tr id="empty_po_row">
                                                        <td colspan="5" class="text-center text-muted py-3 small">
                                                            <i class="fa fa-info-circle me-1"/> Upload and process a CFDI XML file to load purchase lines.
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: XML Lines Drag & Drop -->
                                <div class="col-md-6">
                                    <div class="card shadow-sm border">
                                        <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center" style="background-color: #EAF1F9 !important;">
                                            <span class="fw-bold text-uppercase small" style="color: #2C3E66 !important; font-size: 0.75rem;">
                                                <i class="fa fa-file-code-o me-1"/> SAT CFDI Lines (Drag to align)
                                            </span>
                                            <span class="badge bg-secondary" style="font-size: 0.65rem;">Drag &amp; Drop</span>
                                        </div>
                                        <div class="table-responsive" style="min-height: 180px;">
                                            <table class="table table-hover align-middle m-0 table-sm sat-compact-table">
                                                <thead>
                                                    <tr class="small border-bottom" style="background-color: #F8FAFC !important;">
                                                        <th style="width: 20%;">XML Folio</th>
                                                        <th style="width: 55%;">XML Concept Description</th>
                                                        <th class="text-end pe-2" style="width: 25%;">XML Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="local_sat_xml_tbody">
                                                    <tr id="empty_xml_row">
                                                        <td colspan="3" class="text-center text-muted py-3 small">
                                                            <i class="fa fa-info-circle me-1"/> Process XML to view CFDI lines.
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Totals Footer Container -->
                            <div id="local_sat_package_preview_tfoot" class="card card-body bg-light py-2 mt-2 border" style="display: none; background-color: #EEF4FA !important;">
                                <div class="row align-items-center">
                                    <div class="col-md-6 text-end pe-4 border-end">
                                        <span class="small text-uppercase fw-bold me-2" style="color: #2C3E66 !important;">TOTAL PO SELECTED:</span>
                                        <span id="po_total_subtotal" class="fw-bold" style="color: #2F6FB0 !important;">$0.00</span>
                                    </div>
                                    <div class="col-md-6 text-end pe-4">
                                        <span class="small text-uppercase fw-bold me-2" style="color: #2C3E66 !important;">TOTAL XML:</span>
                                        <span id="xml_total_subtotal" class="fw-bold" style="color: #2F6FB0 !important;">$0.00</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic Validation Feedback Area -->
                            <div id="sat_modal_validation_feedback" class="mt-2" style="display: none;"/>
                        </div>
                        <div class="modal-footer py-2 px-3" style="background-color: #F8FAFC !important;">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal" tabindex="-1">Close</button>
                            <button type="button" id="validate_all_sat_packages_btn" class="btn btn-ike-force btn-sm px-4" t-att-data-order-id="order.id" disabled="disabled" style="background-color: #2F6FB0 !important; border-color: #2F6FB0 !important; color: #ffffff !important;">
                                <i class="fa fa-check-circle me-1"/> Validate &amp; Create Invoice
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MODAL: SAT HISTORICAL AUDIT LOG -->
            <div class="modal fade" id="modal_history_sat_packages" tabindex="-1" aria-hidden="true" data-bs-focus="false">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 85% !important;">
                    <div class="modal-content">
                        <div class="modal-header py-2" style="background-color: #F7F9FC !important; border-bottom: 1px solid #DCE3EB !important;">
                            <h6 class="modal-title m-0 fw-bold" style="color: #2C3E66 !important;">
                                <i class="fa fa-history me-2" style="color: #2F6FB0 !important;"/> Audit Log of Validated Packages (SAT)
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" tabindex="-1"/>
                        </div>
                        <div class="modal-body p-3">
                            <t t-set="existing_sat_lines" t-value="request.env['custom.sat.validator.line'].sudo().search([('validator_id.purchase_id', '=', order.id)], order='create_date desc')"/>

                            <div t-if="not existing_sat_lines" class="alert alert-info text-center py-3 my-2 small">
                                <i class="fa fa-folder-open-o fa-2x d-block mb-1 text-muted"/>
                                No package documents have been uploaded for this order.
                            </div>

                            <div t-if="existing_sat_lines" class="table-responsive border rounded shadow-sm">
                                <table class="table table-striped table-hover align-middle m-0 table-sm sat-compact-table">
                                    <thead>
                                        <tr class="ike-col-row font-weight-bold">
                                            <th class="ps-2" style="width: 15%; background-color: #F8FAFC !important; color: #3E5D78 !important;">Reference / File</th>
                                            <th style="width: 20%; background-color: #F8FAFC !important; color: #3E5D78 !important;">UUID (Folio Fiscal)</th>
                                            <th class="text-end" style="width: 12%; background-color: #F8FAFC !important; color: #3E5D78 !important;">Total Amount</th>
                                            <th class="text-center" style="width: 10%; background-color: #F8FAFC !important; color: #3E5D78 !important;">Workflow State</th>
                                            <th class="text-center" style="width: 18%; background-color: #F8FAFC !important; color: #3E5D78 !important;">PDF Downloads</th>
                                            <th class="text-start" style="width: 25%; background-color: #F8FAFC !important; color: #3E5D78 !important;">Validation Log</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="existing_sat_lines" t-as="line">
                                            <tr>
                                                <td class="fw-bold text-dark ps-2 align-top">
                                                    <span t-out="line.name"/>
                                                </td>
                                                <td class="text-muted font-monospace align-top text-break text-wrap" style="font-size: 0.75rem; max-width: 200px;">
                                                    <span t-out="line.sat_uuid or 'N/A'"/>
                                                </td>
                                                <td class="text-end fw-bold align-top">
                                                    <span t-out="line.total_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </td>
                                                <td class="text-center align-top">
                                                    <span t-attf-class="badge px-2 py-1 #{'bg-success' if line.line_state == 'validated' else 'bg-danger' if line.line_state == 'xml_error' else 'bg-info'}" t-out="line.line_state"/>
                                                </td>
                                                <td class="text-center align-top">
                                                    <t t-if="line.invoice_id">
                                                        <div class="d-flex justify-content-center gap-1">
                                                            <t t-if="line.invoice_id.x_vendor_bill_pdf_file">
                                                                <a t-attf-href="/my/purchase/download_vendor_pdf/#{line.invoice_id.id}" class="btn btn-xs btn-success text-white py-0 px-2 font-weight-bold small" target="_blank" title="Download Original Vendor PDF">
                                                                    <i class="fa fa-download me-1"/> Vendor PDF
                                                                </a>
                                                            </t>
                                                            <a t-attf-href="/my/purchase/download_system_pdf/#{line.invoice_id.id}" class="btn btn-xs btn-outline-primary py-0 px-2 font-weight-bold small" target="_blank" title="Download System Generated PDF">
                                                                <i class="fa fa-file-pdf-o me-1"/> System PDF
                                                            </a>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted small"><i class="fa fa-info-circle text-warning me-1"/> Pending</span>
                                                    </t>
                                                </td>
                                                <td class="text-start align-top text-break text-wrap" style="max-width: 250px;">
                                                    <span class="small text-muted" t-out="line.line_validation_log or 'N/A'"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer py-2 px-3" style="background-color: #F8FAFC !important;">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" tabindex="-1">Close Logs</button>
                        </div>
                    </div>
                </div>
            </div>

        </xpath>
    </template>
</odoo>