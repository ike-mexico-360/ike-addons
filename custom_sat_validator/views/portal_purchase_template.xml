<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ike_event_portal_my_purchase_order" name="Purchase Order Detail" inherit_id="purchase.portal_my_purchase_order">
        <!-- <xpath expr="//t[@t-call='portal.portal_record_sidebar']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='quote_content']" position="attributes">
            <attribute name="class">o_portal_content col-12</attribute>
        </xpath>

        <xpath expr="//div[@id='purchase_order_communication']" position="replace">
            <div id="purchase_order_communication" invisible="1">
            </div>
        </xpath> -->
        <xpath expr="//a[@id='print_invoice_report']" position="after">

            <div t-if="order.state in ('purchase','done') and (request.env.user.has_group('ike_event_portal.custom_group_portal_finance'))"
                 class="d-grid gap-2 mt-3"
                 id="sat_validator_portal_root">

                <div class="small fw-bold text-muted text-uppercase border-bottom pb-1 mb-1">
                    <i class="fa fa-shield me-1"/> SAT CFDI Validator
                </div>

                <button type="button"
                        class="btn btn-primary btn-sm text-start shadow-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#modal_upload_sat_packages">
                    <i class="fa fa-upload me-2"/> Import New Packages
                </button>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm text-start shadow-sm text-dark bg-white"
                        data-bs-toggle="modal"
                        data-bs-target="#modal_history_sat_packages">
                    <i class="fa fa-list-alt me-2 text-primary"/> View Uploaded Log
                </button>

                <div id="xml_validation_result" class="mt-1 small"/>
            </div>


            <div class="modal fade" id="modal_upload_sat_packages" tabindex="-1" aria-labelledby="modalUploadLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 80% !important;">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white py-3">
                            <h5 class="modal-title id=modalUploadLabel"><i class="fa fa-cloud-upload me-2"/> Import New Digital Document Packages</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-close="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3 p-3 bg-light border rounded align-items-end mb-4">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-danger">XML File *</label>
                                    <input type="file" id="portal_xml_file" class="form-control" accept=".xml"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">PDF File (Optional)</label>
                                    <input type="file" id="portal_pdf_file" class="form-control" accept=".pdf"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-muted">Carta Porte (Optional)</label>
                                    <input type="file" id="portal_cp_file" class="form-control" accept=".xml,.pdf"/>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" id="add_package_to_list_btn" class="btn btn-secondary w-100">
                                        <i class="fa fa-plus me-1"/> Add Package
                                    </button>
                                </div>
                            </div>

                            <h6 class="fw-bold text-secondary mb-2"><i class="fa fa-table me-2"/> Packages Queue to Process</h6>
                            <div class="table-responsive border rounded" style="min-height: 150px; background-color: #fafafa;">
                                <table class="table table-hover align-middle m-0 table-sm">
                                    <thead class="table-dark">
                                        <tr>
                                            <th class="ps-3">XML Filename</th>
                                            <th>PDF Filename</th>
                                            <th>Carta Porte Filename</th>
                                            <th class="text-center" style="width: 100px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="local_package_preview_tbody">
                                        <tr id="empty_queue_row">
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fa fa-info-circle me-1"/> No packages added to the queue yet. Use the inputs above.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer bg-light p-3">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" id="validate_all_packages_btn" class="btn btn-success px-4" t-att-data-order-id="order.id" disabled="disabled">
                                <i class="fa fa-check-circle me-1"/> Validate &amp; Process Queue
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <div class="modal fade" id="modal_history_sat_packages" tabindex="-1" aria-labelledby="modalHistoryLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 80% !important;">
                    <div class="modal-content">
                        <div class="modal-header bg-dark text-white py-3">
                            <h5 class="modal-title" id="modalHistoryLabel"><i class="fa fa-history me-2"/> Audit Log of Uploaded &amp; Validated Packages</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">

                            <t t-set="existing_lines"
                               t-value="request.env['custom.sat.validator.line'].sudo().search(
                                   [('validator_id.purchase_id', '=', order.id)],
                                   order='create_date desc'
                               )"/>

                            <div t-if="not existing_lines" class="alert alert-info text-center py-4 my-3">
                                <i class="fa fa-folder-open-o fa-2x d-block mb-2 text-muted"/>
                                No package documents have been historically uploaded for this specific purchase order.
                            </div>

                            <div t-if="existing_lines" class="table-responsive border rounded shadow-sm">
                                <table class="table table-striped table-hover align-middle m-0 table-sm">
                                    <thead class="table-secondary font-weight-bold">
                                        <tr>
                                            <th class="ps-3">Folio / XML Name</th>
                                            <th>Fiscal Folio (UUID)</th>
                                            <th class="text-end">XML Total</th>
                                            <th class="text-center">SAT Cloud Status</th>
                                            <th class="text-center">Workflow State</th>
                                            <th class="text-center" style="width: 120px;">Vendor Bill</th>
                                            <th class="text-start">Validation Log</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="existing_lines" t-as="line">
                                            <tr>
                                                <td class="fw-bold text-dark ps-3">
                                                    <span t-out="line.name"/>
                                                </td>
                                                <td class="text-muted font-monospace" style="font-size: 0.85rem;">
                                                    <span t-out="line.sat_uuid or 'N/A'"/>
                                                </td>
                                                <td class="text-end fw-bold">
                                                    <span t-out="line.total_amount" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-attf-class="badge rounded-pill px-2 py-1 #{
                                                        'bg-success' if line.sat_status == 'Vigente' else
                                                        'bg-danger' if line.sat_status in ['Cancelado', 'Error'] else 'bg-warning text-dark'
                                                    }" t-out="line.sat_status"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-attf-class="badge px-2 py-1 #{
                                                        'bg-success' if line.line_state == 'validated' else
                                                        'bg-danger' if line.line_state == 'xml_error' else 'bg-info'
                                                    }" t-out="line.line_state"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="line.invoice_id">
                                                        <a t-attf-href="/my/purchase/download_cfdi_pdf2/#{line.invoice_id.id}"
                                                           class="btn btn-xs btn-success text-white py-1 px-2 font-weight-bold small"
                                                           target="_blank">
                                                            <i class="fa fa-file-pdf-o me-1"/> PDF
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted small" t-att-title="line.line_validation_log">
                                                            <i class="fa fa-info-circle text-warning me-1"/> Logs
                                                        </span>
                                                    </t>
                                                </td>
                                                <td class="text-start align-middle" style="max-width: 300px;">
                                                    <span class="small text-muted text-break" t-out="line.line_validation_log or 'No log data available.'"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer bg-light p-3">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close Logs</button>
                        </div>
                    </div>
                </div>
            </div>

        </xpath>
    </template>
</odoo>