<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_inherit_proxy_afirme" model="ir.ui.view">
        <field name="name">res.users.form.inherit.proxy.afirme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="AFIRME" invisible="not share">
                    <field name="x_afirme_portal_access"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
