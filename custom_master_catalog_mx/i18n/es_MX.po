msgid "Contact"
msgstr "Contacto"

#. module: custom_master_catalog_mx
#: model:ir.model,name:custom_master_catalog_mx.model_uom_uom
msgid "Product Unit of Measure"
msgstr "Unidad de medida del producto"

#. module: custom_master_catalog_mx
#. odoo-python
#: code:addons/custom_master_catalog_mx/models/res_partner.py:0
msgid ""
"The RFC must have 12 (legal entity) or 13 (natural person) characters, 3 or "
"4 letters forming the entity code, 6 digits for the incorporation/birth date"
" (YY MM DD), and 3 alphanumeric homoclave characters."
msgstr ""
"El RFC debe tener 12 (persona moral) o 13 (persona física) caracteres, "
"3 o 4 letras que forman la clave de la entidad, 6 dígitos de la fecha de constitución/nacimiento"
" (AA MM DD) y 3 caracteres de homoclave alfanuméricos."

#. module: custom_master_catalog_mx
#. odoo-python
#: code:addons/custom_master_catalog_mx/models/res_partner.py:0
msgid ""
"The name cannot contain special characters. Only letters, numbers, spaces, "
"commas, periods, hyphens, and parentheses are allowed."
msgstr ""
"El nombre no puede contener caracteres especiales. Solo se permiten letras, "
"números, espacios, comas, puntos, guiones medios y paréntesis."
