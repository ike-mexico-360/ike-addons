#: code:addons/custom_master_catalog_mx/models/res_partner.py:0
msgid "A record with this Identification Number / VAT (%s) already exists."
msgstr "Ya existe un registro con este número de identificación / RFC (%s)."

#. module: custom_master_catalog_mx
