#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.appoint_mgmt_new_appoint_mail_to_customer
msgid ""
"<p>Dear <t t-out=\"object.customer.name\"/> , </p>\n"
"                        <br/>\n"
"                        <p>A new Appointment Request has been successfully generated.</p>\n"
"                        <p>Please wait while the status of this appointment will be updated.</p>\n"
"                        <br/>\n"
"                        <b>Date :</b> <t t-out=\"object.appoint_date\"/>\n"
"                        <t t-if=\"object.time_slot\">\n"
"                            <b>Time :</b> <t t-out=\"object.time_slot.name\"/>\n"
"                        </t>\n"
"                        <b>Appointment With:  </b> <t t-out=\"object.appoint_person_id.name or ''\"/>\n"
"                        <br/>\n"
"                        <p>Thank you,</p>\n"
"\n"
"                        <p>(<t t-out=\"object.create_uid.company_id.name\"/>)</p>\n"
"            "
msgstr ""

#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.appoint_mgmt_reject_email_template_to_customer
msgid ""
"<p>Dear <t t-out=\"object.customer.name\"/> , </p>\n"
"                        <br/>\n"
"                        <p>Your Appointment has been Rejected due to <t t-out=\"object.reject_reason\"/>.</p>\n"
"                        <p>You can reply to this email regarding any query.</p><br/>\n"
"                        <p>Thank you,</p>\n"
"                        <p t-if=\"object.appoint_person_id.user_id.name\" style=\"color:black;\"><i>\n"
"                            <t t-out=\"object.appoint_person_id.user_id.name or ''\"/>\n"
"                    </i></p>\n"
"                        <p>(<t t-out=\"object.create_uid.company_id.name\"/>)</p>\n"
"            "
msgstr ""

#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.appoint_mgmt_email_template_to_customer
msgid ""
"<p>Dear <t t-out=\"object.customer.name\"/>, </p>\n"
"                        <br/>\n"
"                        <p>Your Appointment at <t t-out=\"object.create_uid.company_id.name\"/> has been confirmed.</p>\n"
"                        <p>Kindly be on time.</p>\n"
"                        <br/>\n"
"                        <b>Date :</b> <t t-out=\"object.appoint_date\"/>\n"
"                        <t t-if=\"object.time_slot\">\n"
"                         <b>Time :</b> <t t-out=\"object.time_slot.name\"/>\n"
"                        </t>\n"
"                        <b>Appointment With:  </b> <t t-out=\"object.appoint_person_id.name or ''\"/>\n"
"                        <br/>\n"
"                        <p>You can reply to this email if you have any questions.</p><br/>\n"
"                        <p>Thank you,</p>\n"
"\n"
"                        <p style=\"color:black;\" class=\"font-italic\">\n"
"                            <t t-if=\"object.appoint_person_id.user_id.name\">\n"
"                                <t t-out=\"object.appoint_person_id.user_id.name or ''\"/>\n"
"                            </t>\n"
"                        </p>\n"
"                        <p>(<t t-out=\"object.create_uid.company_id.name or ''\"/>)</p>\n"
"            "
msgstr ""

#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.reminder_mail_to_customer
msgid ""
"<p>Hello <t t-out=\"object.customer.display_name\"/>,</p>\n"
"                                    <p>This is a reminder mail.</p>\n"
"                                    <p>Your Appointment <t t-out=\"object.name\"/> has been scheduled on <t t-out=\"object.appoint_date\"/> and the details are as follows :-</p>\n"
"                                    <table>\n"
"                                        <tr>\n"
"                                            <td><b>Appointment </b></td>\n"
"                                            <td>: <t t-out=\"object.name\"/></td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td><b>Date </b></td>\n"
"                                            <td>: <t t-out=\"object.appoint_date\"/></td>\n"
"                                        </tr>\n"
"                                        <tr>\n"
"                                            <td><b>Appointment With </b></td>\n"
"                                            <td>: <t t-out=\"object.appoint_person_id.name\"/> </td>\n"
"                                        </tr>\n"
"                                        <t t-if=\"object.time_slot\">\n"
"                                            <tr>\n"
"                                                <td><b>Timeslot </b></td>\n"
"                                                <td>: <t t-out=\"object.time_slot.name\"/> </td>\n"
"                                            </tr>\n"
"                                        </t>\n"
"                                        <tr>\n"
"                                            <td><b>Status </b></td>\n"
"                                            <td style=\"text-transform:capitalize;\"><b>: <t t-out=\"object.appoint_state\"/></b></td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                    <p>Kindly be on time.</p>\n"
"                                    <p>Thank you,</p>\n"
"                                    <p>(<t t-out=\"object.create_uid.company_id.name\"/>)</p>\n"
"            "
msgstr ""

