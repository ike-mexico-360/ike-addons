#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.appoint_mgmt_new_appoint_mail_to_appointee
msgid ""
"<p>Dear <t t-out=\"object.appoint_person_id.name\"/> , </p>\n"
"                        <br/>\n"
"                        <p>A new Appointment Request has been successfully generated.</p>\n"
"                        <p>Kindly update the status of this appointment.</p>\n"
"                        <br/>\n"
"                        <b>Date :</b> <t t-out=\"object.appoint_date\"/>\n"
"                        <t t-if=\"object.time_slot\">\n"
"                            <b>Time :</b> <t t-out=\"object.time_slot.name\"/>                        \n"
"                        </t>\n"
"                        <b>Customer Name:  </b> <t t-out=\"object.customer.name or ''\"/>\n"
"                        <br/>\n"
"                        <p>Thank you,</p>\n"
"                        <p>(<t t-out=\"object.create_uid.company_id.name\"/>)</p>\n"
"            "
msgstr ""

#. module: wk_appointment
#: model:mail.template,body_html:wk_appointment.appoint_mgmt_new_appoint_mail_to_admin
msgid ""
"<p>Dear <t t-out=\"object.create_uid.company_id.name\"/> , </p>\n"
"                        <br/>\n"
"                        <p>A new Appointment Request has been successfully generated.</p>\n"
"                        <p>Kindly update the status of this appointment.</p>\n"
"                        <br/>\n"
"                        <b>Date :</b> <t t-out=\"object.appoint_date\"/>\n"
"                        <t t-if=\"object.time_slot\">\n"
"                            <b>Time :</b> <t t-out=\"object.time_slot.name\"/>                        \n"
"                        </t>\n"
"                        <b>Customer Name:  </b> <t t-out=\"object.customer.name or ''\"/>\n"
"                        <br/>\n"
