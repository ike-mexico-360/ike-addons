<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.portal</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='integration']" position="inside">
                    <setting id="events_allow_send_whatsapp" string="Send whatsapp notifications" help="Allow users to send whatsapp notifications" groups="base.group_no_one">
                        <field name="events_allow_send_whatsapp"/>
                    </setting>
                    <setting id="x_allow_email_sending"
                             string="Allow email sending"
                             help="Master switch for outgoing emails of this company. Disabled by default."
                             groups="base.group_system">
                        <field name="x_allow_email_sending"/>
                    </setting>
                </xpath>
            </field>
        </record>

        <record id="res_config_settings_view_form_purchase_inherit_cm_catalog" model="ir.ui.view">
        <field name="name">res_config_settings_view_form_purchase.inherit.cm_catalog</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']/setting[@id='auto_receipt_reminder']" position="after">
                <setting id="x_default_purchase_project_id"
                            string="Default Purchase Project"
                            help="Technical: Default purchase project linked to the company at consolidate and send SAP data.">
                    <field name="x_default_purchase_project_id" options="{'no_open': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

    </data>
</odoo>
