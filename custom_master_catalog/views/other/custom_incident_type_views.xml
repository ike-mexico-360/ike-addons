<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="custom_incident_type_view_search" model="ir.ui.view">
        <field name="name">custom_incident_type.view.search</field>
        <field name="model">custom.incident.type</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="ref"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="custom_incident_type_view_list" model="ir.ui.view">
        <field name="name">custom_incident_type.view.list</field>
        <field name="model">custom.incident.type</field>
        <field name="arch" type="xml">
            <list string="" create="0" delete="0" editable="bottom">
                <field name="ref"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="custom_incident_type_action" model="ir.actions.act_window">
        <field name="name">Incident types</field>
        <field name="res_model">custom.incident.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
