<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View List -->
    <record id="custom_metropolitan_zone_view_list" model="ir.ui.view">
        <field name="name">custom.metropolitan.zone.view.list</field>
        <field name="model">custom.metropolitan.zone</field>
        <field name="arch" type="xml">
            <list edit="0" delete="1">
                <field name="name"/>
                <field name="municipality_ids"/>
            </list>
        </field>
    </record>

    <!-- View form -->
    <record id="custom_metropolitan_zone_view_form" model="ir.ui.view">
        <field name="name">custom.metropolitan.zone.view.form</field>
        <field name="model">custom.metropolitan.zone</field>
        <field name="arch" type="xml">
            <form string="Custom Metropolitan Zone">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="municipality" string="Municipalities">
                            <field name="municipality_ids" options="{'no_create': True}">
                                <list editable="top" create="0">
                                    <field name="name" readonly="1"/>
                                    <field name="state_id" readonly="1" options="{'no_open': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View search -->
    <record id="custom_metropolitan_zone_view_search" model="ir.ui.view">
        <field name="name">custom.metropolitan.zone.view.search</field>
        <field name="model">custom.metropolitan.zone</field>
        <field name="arch" type="xml">
            <search>
                <filter name="enabled" string="Enabled" domain="[('disabled', '=', False)]"/>
                <filter name="disabled" string="Disabled" domain="[('disabled', '=', True)]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_metropolitan_zone" model="ir.actions.act_window">
        <field name="name">Metropolitan Zone</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">custom.metropolitan.zone</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_enabled': 1}</field>
    </record>

</odoo>
