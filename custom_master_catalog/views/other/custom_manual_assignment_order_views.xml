<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_manual_assignment_order_view_search" model="ir.ui.view">
        <field name="name">custom.manual.assignment.order.view.search</field>
        <field name="model">custom.manual.assignment.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="state_id"/>
                <field name="municipality_id"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="supplier_center_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Geographical Zone" context="{'group_by': 'state_id'}"/>
                    <filter name="group_by_municipality" string="Geographical Zone" context="{'group_by': 'municipality_id'}"/>
                    <filter name="group_by_subservice" string="Subservice" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="custom_manual_assignment_order_view_list" model="ir.ui.view">
        <field name="name">custom.manual.assignment.order.view.list</field>
        <field name="model">custom.manual.assignment.order</field>
        <field name="arch" type="xml">
            <list string="Manual Assignment Order Configuration" editable="bottom" duplicate="0">
                <field name="sequence" widget="handle"/>
                <field name="state_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="municipality_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="supplier_id" readonly="1" force_save="1"/>
                <field name="supplier_center_id" options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>

    <record id="custom_manual_assignment_order_action" model="ir.actions.act_window">
        <field name="name">Manual Assignment Order Configuration</field>
        <field name="res_model">custom.manual.assignment.order</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="custom_manual_assignment_order_view_search"/>
        <field name="context">{'search_default_group_by_state': 1, 'search_default_group_by_subservice': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure the manual assignment order</p>
            <p>Only care centers belonging to suppliers configured for manual assignment are allowed.</p>
        </field>
    </record>

    <record id="custom_manual_assignment_order_client_action" model="ir.actions.client">
        <field name="name">Manual Assignment Order Configuration</field>
        <field name="tag">custom_master_catalog.manual_assignment_order</field>
    </record>
</odoo>
