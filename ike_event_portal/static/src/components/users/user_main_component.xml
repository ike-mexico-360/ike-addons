<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ike_event_portal.UsersMainComponent" owl="1">
        <div class="portal-main-container">
            <!-- Provider Header -->
            <div class="d-flex flex-wrap align-items-center justify-content-between px-3 py-2 mb-3 rounded-3"
                style="background-color:#0b1f4d; color:#fff; gap:1rem;">
                <div>
                    <div class="text-uppercase small" style="opacity:0.7; letter-spacing:0.05em;">Provider</div>
                    <div class="fw-bold">
                        <t t-esc="state.header.supplierName"/>
                        <span class="fw-normal small ms-1" style="opacity:0.8;" t-if="state.header.supplierRfc">
                            RFC <t t-esc="state.header.supplierRfc"/>
                        </span>
                    </div>
                </div>
                <div t-if="state.header.centers.length" class="position-relative">
                    <div class="text-uppercase small" style="opacity:0.7; letter-spacing:0.05em;">Center of Attention</div>
                    <button type="button" class="btn btn-sm dropdown-toggle"
                        style="background-color:#17306e; color:#fff; border:1px solid rgba(255,255,255,0.2);"
                        t-on-click.stop="toggleCenterMenu">
                        <t t-esc="selectedCenterName"/>
                    </button>
                    <ul t-if="state.header.centerMenuOpen" class="dropdown-menu d-block" style="position:absolute; top:100%; left:0; z-index:1000;">
                        <li>
                            <a href="#" class="dropdown-item" t-on-click.prevent="() => this.selectCenter(null)">All Centers</a>
                        </li>
                        <t t-foreach="state.header.centers" t-as="center" t-key="center.id">
                            <li>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.selectCenter(center.id)" t-esc="center.name"/>
                            </li>
                        </t>
                    </ul>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                        style="width:36px; height:36px; background-color:#3b5bdb; flex-shrink:0;"
                        t-esc="userInitials"/>
                    <div class="small">
                        <div class="fw-bold" t-esc="state.header.userName"/>
                        <div style="opacity:0.8;">
                            <t t-esc="state.header.userRole"/>
                            <t t-if="state.header.userEmail"> · <t t-esc="state.header.userEmail"/></t>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-light ms-2" t-on-click="logout">Close Session</button>
                </div>
            </div>

            <t t-if="state.notification">
                <div t-attf-class="alert alert-{{state.notification.type}} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
                    <strong t-esc="state.notification.message"/>
                    <button type="button" class="btn-close" aria-label="Close" t-on-click="closeNotification"></button>
                </div>
            </t>

            <!-- Loading Indicator -->
            <div t-if="state.isLoading" class="text-center my-5">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p>Loading...</p>
            </div>

            <!-- VIEW 1: USER LIST -->
            <div t-if="!state.isLoading and state.view === 'list' and !state.isCreating and !state.selectedUserId">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0 fw-bold">Users</h3>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3"
                                t-att-disabled="!filteredUsers.length" t-on-click="downloadExcel">
                            <i class="fa fa-file-excel-o me-1"/>
                            Export to Excel
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-3" t-on-click="openCreateForm">
                            <i class="fa fa-plus me-1"/>
                            New User
                        </button>
                    </div>
                </div>

                <!-- Stat cards: clicking one filters the list by that type -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.user_type ? 'border-0' : 'border-primary bg-primary-subtle'}"
                             t-on-click="() => this.updateFilter('user_type', '')">
                            <div class="card-body py-3">
                                <div class="text-muted small">Total Users</div>
                                <div class="fs-3 fw-bold" t-esc="userStats.total"/>
                            </div>
                        </div>
                    </div>
                    <t t-foreach="userTypeCards" t-as="card" t-key="card.type">
                        <div class="col-6 col-md-4 col-lg">
                            <div role="button"
                                 t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.user_type === card.type ? 'bg-light' : 'border-0'}"
                                 t-attf-style="border-top: 3px solid #{card.color} !important;"
                                 t-on-click="() => this.selectUserType(card.type)">
                                <div class="card-body py-3">
                                    <div class="text-muted small" t-esc="card.label"/>
                                    <div class="fs-3 fw-bold" t-esc="card.count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Filters -->
                <form class="o_portal_search_form w-100 mb-3" role="search" t-on-submit.prevent="">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-auto fw-bold small">Filter by:</div>
                        <div class="col-12 col-md">
                            <input type="text" class="form-control" placeholder="Search name..."
                                   t-att-value="state.filters.name"
                                   t-on-input="(ev) => this.updateFilter('name', ev.target.value)"/>
                        </div>
                        <div class="col-12 col-md">
                            <input type="text" class="form-control" placeholder="Search email..."
                                   t-att-value="state.filters.email"
                                   t-on-input="(ev) => this.updateFilter('email', ev.target.value)"/>
                        </div>
                        <div class="col-6 col-md">
                            <select class="form-select" t-on-change="(ev) => this.updateFilter('center_id', ev.target.value)">
                                <option value="" t-att-selected="!state.filters.center_id">Center of Attention: All</option>
                                <t t-foreach="state.header.centers" t-as="center" t-key="center.id">
                                    <option t-att-value="center.id" t-att-selected="state.filters.center_id == center.id" t-esc="center.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-6 col-md-auto">
                            <select class="form-select" t-on-change="(ev) => this.updateFilter('user_type', ev.target.value)">
                                <option value="" t-att-selected="!state.filters.user_type">Type: All</option>
                                <t t-foreach="userTypeCards" t-as="card" t-key="card.type">
                                    <option t-att-value="card.type" t-att-selected="state.filters.user_type === card.type" t-esc="card.label"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-auto">
                            <a href="#" class="small" t-on-click.prevent="clearFilters">Clear Filters</a>
                        </div>
                    </div>
                </form>

                <!-- Columns menu -->
                <div class="position-relative mb-2">
                    <a href="#" class="small" t-on-click.prevent.stop="toggleColumnMenu">
                        <i class="fa fa-columns me-1"/>Columns
                    </a>
                    <div t-if="state.columnMenuOpen" class="dropdown-menu d-block p-3 shadow"
                         style="min-width: 220px; z-index: 1000;" t-on-click.stop="() => {}">
                        <div class="small text-muted mb-2">Choose the columns to display</div>
                        <t t-foreach="optionalUserColumns" t-as="column" t-key="column.key">
                            <label class="form-check d-block mb-2">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="this.isColumnVisible(column.key)"
                                       t-on-change="(ev) => this.toggleColumn(column.key, ev.target.checked)"/>
                                <span class="form-check-label" t-esc="column.label"/>
                            </label>
                        </t>
                    </div>
                </div>

                <PaginationComponent pagination="pagination">
                    <table class="usuarios-table">
                        <thead>
                            <tr>
                                <th role="button" class="text-nowrap" t-on-click="() => this.toggleSort('name')">Name <i t-att-class="this.sortIcon('name')"/></th>
                                <th t-if="this.isColumnVisible('email')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('email')">Email <i t-att-class="this.sortIcon('email')"/></th>
                                <th t-if="this.isColumnVisible('center')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('center')">Center of Attention <i t-att-class="this.sortIcon('center')"/></th>
                                <th t-if="this.isColumnVisible('user_type')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('user_type')">Type <i t-att-class="this.sortIcon('user_type')"/></th>
                                <th t-if="this.isColumnVisible('last_change')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('last_change')">Last Change <i t-att-class="this.sortIcon('last_change')"/></th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pagination.paginatedItems" t-as="user" t-key="user.id">
                                <tr t-att-class="user.active ? '' : 'text-muted'">
                                    <td class="fw-bold">
                                        <t t-esc="user.name"/>
                                        <span t-if="!user.active" class="badge bg-secondary-subtle text-secondary ms-1">Inactive</span>
                                    </td>
                                    <td t-if="this.isColumnVisible('email')">
                                        <t t-esc="user.email or user.login or '-'"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('center')">
                                        <t t-esc="user.center_of_attention_name or '-'"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('user_type')">
                                        <span t-if="user.user_type" t-attf-class="badge rounded-pill #{this.userTypeBadgeClass(user.user_type)}"
                                              t-esc="this.userTypeLabel(user.user_type)"/>
                                        <t t-else="">-</t>
                                    </td>
                                    <td t-if="this.isColumnVisible('last_change')">
                                        <t t-if="user.last_change_date">
                                            <div t-esc="user.last_change_date"/>
                                            <small class="text-muted" t-esc="user.last_change_user"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-primary btn-sm rounded-pill px-3 text-nowrap" t-on-click="() => this.selectUser(user.id)">View details</button>
                                            <div t-if="state.isAdmin" class="position-relative">
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm px-2"
                                                        t-att-disabled="state.updatingUserId === user.id"
                                                        title="Actions"
                                                        t-on-click.stop="() => this.toggleActionsMenu(user.id)">
                                                    <i t-att-class="state.updatingUserId === user.id ? 'fa fa-spinner fa-spin' : 'fa fa-ellipsis-v'"/>
                                                </button>
                                                <ul t-if="state.actionsMenuUserId === user.id"
                                                    class="dropdown-menu dropdown-menu-end d-block"
                                                    style="position:absolute; top:100%; right:0; z-index:1000;">
                                                    <li>
                                                        <button type="button" class="dropdown-item" t-on-click="() => this.onEditClick(user)">
                                                            <i class="fa fa-pencil me-2"/>Edit
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item" t-on-click="() => this.onResetPasswordClick(user)">
                                                            <i class="fa fa-key me-2"/>Reset Password
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button"
                                                                t-attf-class="dropdown-item #{this.isCurrentUser(user) ? 'disabled' : ''}"
                                                                t-on-click="() => this.onToggleActiveClick(user)">
                                                            <t t-if="user.active"><i class="fa fa-ban me-2"/>Deactivate</t>
                                                            <t t-else=""><i class="fa fa-check me-2"/>Activate</t>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="!filteredUsers.length">
                                <td t-att-colspan="this.userColumnCount" class="text-center">No users found.</td>
                            </tr>
                        </tbody>
                    </table>
                </PaginationComponent>
                <div t-if="state.isAdmin" class="small text-muted mt-2">
                    <i class="fa fa-ellipsis-v me-1"/>
                    Quick Actions: Edit, Reset Password, Deactivate
                </div>
            </div>
            <!-- MODE 1: CREATE -->
            <t t-if="state.isCreating">
                <UserCreateComponent
                        onUserCreated.bind="onUserCreated"
                        onCancel.bind="closeCreateForm"
                    />
            </t>
            <!-- MODE 2: READ (Details) -->
            <t t-if="state.selectedUserId">
                <UserReadComponent
                        userId="state.selectedUserId"
                        onClose.bind="clearSelection"
                        onUserUpdated.bind="loadUsers"
                    />
            </t>
        </div>
    </t>
</templates>
