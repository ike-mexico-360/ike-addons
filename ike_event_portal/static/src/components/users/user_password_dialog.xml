<templates xml:space="preserve">
    <t t-name="ike_event_portal.UserPasswordDialog" owl="1">
        <Dialog title.translate="Change Password" size="'md'">
            <!-- Server error -->
            <div class="alert alert-danger" role="alert" t-if="state.saveError">
                <t t-esc="state.saveError"/>
            </div>

            <p class="text-muted" t-if="props.userName">
                <i class="fa fa-user-circle me-1"/> <t t-esc="props.userName"/>
            </p>

            <!-- New password -->
            <div class="mb-3">
                <label class="form-label small fw-bold text-uppercase text-muted">New Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control" autocomplete="new-password"
                       t-att-class="{'is-invalid': state.errors.password}" t-model="state.password"/>
                <div class="invalid-feedback" t-if="state.errors.password"><t t-esc="state.errors.password"/></div>
            </div>

            <!-- Confirm password -->
            <div class="mb-3">
                <label class="form-label small fw-bold text-uppercase text-muted">Confirm Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control" autocomplete="new-password"
                       t-att-class="{'is-invalid': state.errors.confirmPassword}" t-model="state.confirmPassword"/>
                <div class="invalid-feedback" t-if="state.errors.confirmPassword"><t t-esc="state.errors.confirmPassword"/></div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="save" t-att-disabled="state.isSaving">
                    <t t-if="state.isSaving">Saving...</t>
                    <t t-else="">Change Password</t>
                </button>
                <button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.isSaving">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
