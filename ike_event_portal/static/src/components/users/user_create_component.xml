<templates xml:space="preserve">
    <t t-name="ike_event_portal.UserCreateComponent" owl="1">
        <div class="user-create-container p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <img src="/ike_event_portal/static/src/assets/GruaAzul.png" alt="Users" class="me-3" style="width:30px;" />
                    <h1 class="fw-bold mb-0">Add User</h1>
                </div>
                <a href="/provider/portal/users" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"/> Back to List
                </a>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form t-on-submit.prevent="saveUser">
                        <!-- Radio Buttons for User Type: se elige primero -->
                        <div class="mb-4 pb-3 border-bottom">
                            <h5 class="text-primary mb-3">User Type</h5>
                            <div class="d-flex flex-wrap gap-4" t-on-change="onUserTypeChange">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="userType" id="typeFinancial"
                                       value="financial" t-model="state.formData.user_type"/>
                                    <label class="form-check-label fw-bold" for="typeFinancial">Financial (Administrative)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="userType" id="typeSupervisor"
                                       value="supervisor" t-model="state.formData.user_type"/>
                                    <label class="form-check-label fw-bold" for="typeSupervisor">Supervisor</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="userType" id="typeOperator"
                                       value="operator" t-model="state.formData.user_type"/>
                                    <label class="form-check-label fw-bold" for="typeOperator">Operator</label>
                                </div>
                            </div>
                        </div>
                        <div class="row g-5">
                            <div class="col-md-6">
                                <h5 class="text-primary border-bottom pb-2 mb-4">User Information</h5>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">First Name</label>
                                    <input type="text" class="form-control" t-att-class="{'is-invalid': state.errors.firstname}" t-model="state.formData.firstname" placeholder="First Name"/>
                                    <div class="invalid-feedback" t-if="state.errors.firstname">
                                        <t t-esc="state.errors.firstname"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Last Name</label>
                                    <input type="text" class="form-control" t-att-class="{'is-invalid': state.errors.lastname}" t-model="state.formData.lastname" placeholder="Last Name"/>
                                    <div class="invalid-feedback" t-if="state.errors.lastname">
                                        <t t-esc="state.errors.lastname"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Date of Birth</label>
                                    <input type="date" class="form-control" t-model="state.formData.birthdate"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Email</label>
                                    <input type="email" class="form-control" t-att-class="{'is-invalid': state.errors.email}" t-model="state.formData.email"
                                       t-att-readonly="isOperator"
                                       t-att-placeholder="'email@ejemplo.com'"/>
                                    <div class="invalid-feedback" t-if="state.errors.email">
                                        <t t-esc="state.errors.email"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Password <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" t-att-class="{'is-invalid': state.errors.password}" t-model="state.formData.password" placeholder="*******"/>
                                    <div class="invalid-feedback" t-if="state.errors.password">
                                        <t t-esc="state.errors.password"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Phone</label>
                                    <input type="tel" class="form-control" t-att-class="{'is-invalid': state.errors.phone}" t-model="state.formData.phone" placeholder="Phone"/>
                                    <div class="invalid-feedback" t-if="state.errors.phone">
                                        <t t-esc="state.errors.phone"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">License Type</label>
                                    <input type="text" class="form-control" t-att-class="{'is-invalid': state.errors.license_type}" t-model="state.formData.license_type" placeholder="License Type"/>
                                    <div class="invalid-feedback" t-if="state.errors.license_type">
                                        <t t-esc="state.errors.license_type"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">License Number</label>
                                    <input type="text" class="form-control" t-att-class="{'is-invalid': state.errors.license_number}" t-model="state.formData.license_number" placeholder="License Number"/>
                                    <div class="invalid-feedback" t-if="state.errors.license_number">
                                        <t t-esc="state.errors.license_number"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Expiration Date</label>
                                    <input type="date" class="form-control" t-att-class="{'is-invalid': state.errors.license_validity}" t-model="state.formData.license_validity"/>
                                    <div class="invalid-feedback" t-if="state.errors.license_validity">
                                        <t t-esc="state.errors.license_validity"/>
                                    </div>
                                </div>
                            </div>
                            <!-- RIGHT COLUMN: Dirección -->
                            <div class="col-md-6">
                                <h5 class="text-primary border-bottom pb-2 mb-4">Address</h5>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Street and Number</label>
                                    <input type="text" class="form-control" t-model="state.formData.street" placeholder="Street and Number"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Street 2</label>
                                    <input type="text" class="form-control" t-model="state.formData.street2" placeholder="Street 2"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Colony</label>
                                    <input type="text" class="form-control" t-model="state.formData.colony" placeholder="Colony"/>
                                </div>
                                <!-- Row for CP, Municipio, Estado -->
                                <div class="row g-2 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-uppercase text-muted">CP</label>
                                        <input type="text" class="form-control" t-model="state.formData.zip" placeholder="CP"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-uppercase text-muted">Municipality</label>
                                        <input type="text" class="form-control" t-model="state.formData.municipality" placeholder="Municipality"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-uppercase text-muted">State</label>
                                        <select class="form-select" t-model="state.formData.state_id">
                                            <option value="">Select...</option>
                                            <t t-foreach="state.states" t-as="st" t-key="st.id">
                                                <option t-att-value="st.id">
                                                    <t t-esc="st.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Country</label>
                                    <select class="form-select" t-on-change="onCountryChange">
                                        <option value="">Select...</option>
                                        <t t-foreach="state.countries" t-as="country" t-key="country.id">
                                            <option t-att-value="country.id" t-att-selected="state.formData.country_id == country.id">
                                                <t t-esc="country.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Center of Attention <span class="text-danger">*</span></label>
                                    <select class="form-select" t-att-class="{'is-invalid': state.errors.center_of_attention_id}" t-model="state.formData.center_of_attention_id">
                                        <option value="">Select...</option>
                                        <t t-foreach="state.supplierCenters" t-as="center" t-key="center.id">
                                            <option t-att-value="center.id" t-att-selected="state.formData.center_of_attention_id == center.id">
                                                <t t-esc="center.name"/>
                                            </option>
                                        </t>
                                    </select>
                                    <div class="invalid-feedback" t-if="state.errors.center_of_attention_id">
                                        <t t-esc="state.errors.center_of_attention_id"/>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-end gap-2 mt-5 pt-3 border-top">
                                    <button type="button"
                                    class="btn btn-outline-secondary"
                                    t-on-click="props.onCancel"
                                    t-att-disabled="state.isSubmitting">
                                Cancel
                                </button>
                                    <button type="submit"
                                    class="btn btn-primary px-5"
                                    t-att-disabled="state.isSubmitting">
                                        <t t-if="state.isSubmitting">Saving...</t>
                                        <t t-else="">Save</t>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </t>
</templates>