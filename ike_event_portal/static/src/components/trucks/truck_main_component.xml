<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ike_event_portal.TrucksComponent" owl="1">
        <div class="portal-main-container">
            <!-- Provider Header -->
            <div class="d-flex flex-wrap align-items-center justify-content-between px-3 py-2 mb-3 rounded-3"
                style="background-color:#0b1f4d; color:#fff; gap:1rem;">
                <div>
                    <div class="text-uppercase small" style="opacity:0.7; letter-spacing:0.05em;">Supplier</div>
                    <div class="fw-bold">
                        <t t-esc="state.header.supplierName"/>
                        <span class="fw-normal small ms-1" style="opacity:0.8;" t-if="state.header.supplierRfc">
                            RFC <t t-esc="state.header.supplierRfc"/>
                        </span>
                    </div>
                </div>
                <div t-if="state.header.centers.length" class="position-relative">
                    <div class="text-uppercase small" style="opacity:0.7; letter-spacing:0.05em;">Center of Attention</div>
                    <button type="button" class="btn btn-sm dropdown-toggle"
                        style="background-color:#17306e; color:#fff; border:1px solid rgba(255,255,255,0.2);"
                        t-on-click="toggleCenterMenu">
                        <t t-esc="selectedCenterName"/>
                    </button>
                    <ul t-if="state.header.centerMenuOpen" class="dropdown-menu d-block" style="position:absolute; top:100%; left:0; z-index:1000;">
                        <li>
                            <a href="#" class="dropdown-item" t-on-click.prevent="() => this.selectCenter(null)">All Centers</a>
                        </li>
                        <t t-foreach="state.header.centers" t-as="center" t-key="center.id">
                            <li>
                                <a href="#" class="dropdown-item" t-on-click.prevent="() => this.selectCenter(center.id)" t-esc="center.name"/>
                            </li>
                        </t>
                    </ul>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                        style="width:36px; height:36px; background-color:#3b5bdb; flex-shrink:0;"
                        t-esc="userInitials"/>
                    <div class="small">
                        <div class="fw-bold" t-esc="state.header.userName"/>
                        <div style="opacity:0.8;">
                            <t t-esc="state.header.userRole"/>
                            <t t-if="state.header.userEmail"> · <t t-esc="state.header.userEmail"/></t>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-light ms-2" t-on-click="logout">Sign Out</button>
                </div>
            </div>
            <!-- Loading Indicator -->
            <div t-if="state.isLoading" class="text-center my-5">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p>Loading...</p>
            </div>
            <t t-if="state.notification">
                <div t-attf-class="alert alert-{{state.notification.type}} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
                    <strong t-esc="state.notification.message"/>
                    <button type="button" class="btn-close" aria-label="Close" t-on-click="closeNotification"></button>
                </div>
            </t>
            <!-- CURRENT EVENT SUMMARY MODAL -->
            <t t-if="state.eventSummary.show">
                <div class="modal-backdrop fade show" style="z-index:1040;"/>
                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index:1050;"
                     t-on-click.self="closeEventSummary">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
                        <div class="modal-content border-0 shadow-lg rounded-4">
                            <div class="modal-header bg-primary text-white rounded-top-4">
                                <div>
                                    <h5 class="modal-title mb-0" t-esc="'Evento ' + state.eventSummary.eventName"/>
                                    <small t-if="state.eventSummary.stage" class="opacity-75" t-esc="state.eventSummary.stage"/>
                                </div>
                                <button type="button" class="btn-close btn-close-white" aria-label="Close" t-on-click="closeEventSummary"/>
                            </div>
                            <div class="modal-body">
                                <div t-if="state.eventSummary.isLoading" class="text-center py-4">
                                    <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                                </div>
                                <t t-elif="state.eventSummary.html">
                                    <t t-out="state.eventSummary.html"/>
                                </t>
                                <p t-else="" class="text-muted text-center mb-0">No event information available.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary rounded-pill px-3" t-on-click="closeEventSummary">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <!-- VIEW 1: TRUCK LIST -->
            <div class="trucks-view-container" t-if="!state.isLoading and state.view === 'list' and !state.selectedTruckId">
                <div class="trucks-header d-flex justify-content-between align-items-center mb-3">
                    <div class="trucks-title">
                        <h3 class="mb-0 fw-bold">Service Units</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="position-relative">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3"
                                    t-att-disabled="state.isSavingColumnPreferences"
                                    t-on-click.stop="toggleColumnMenu">
                                <i class="fa fa-columns me-1"/>
                                Columns
                            </button>
                            <div t-if="state.columnMenuOpen" class="dropdown-menu dropdown-menu-end d-block p-3 shadow"
                                 style="min-width: 220px; z-index: 1000;">
                                <div class="small text-muted mb-2">Choose the columns to display</div>
                                <t t-foreach="optionalTruckColumns" t-as="column" t-key="column.key">
                                    <label class="form-check d-block mb-2">
                                        <input type="checkbox" class="form-check-input"
                                               t-att-checked="this.isColumnVisible(column.key)"
                                               t-on-change="(ev) => this.toggleColumn(column.key, ev.target.checked)"/>
                                        <span class="form-check-label" t-esc="column.label"/>
                                    </label>
                                </t>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3"
                                t-att-disabled="!filteredTrucks.length" t-on-click="downloadExcel">
                            <i class="fa fa-file-excel-o me-1"/>
                            Download Excel
                        </button>
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3"
                                t-att-disabled="!filteredTrucks.length" t-on-click="downloadDetailedExcel">
                            <i class="fa fa-file-excel-o me-1"/>
                            Download detailed Excel
                        </button>
                        <!--
                            Temporarily hidden: provider-side unit creation.
                            Keep this button and its showCreateForm flow for the
                            future release; only the portal entry point is hidden.
                        <button type="button" class="btn btn-primary rounded-pill px-3" t-on-click="showCreateForm">
                            <i class="fa fa-plus me-1"/>
                            New Unit
                        </button>
                        -->
                    </div>
                </div>

                <!-- Stat cards: clicking one filters the list by that state -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.vehicle_state ? 'border-0' : 'border-primary bg-primary-subtle'}"
                             t-on-click="() => this.updateFilter('vehicle_state', '')">
                            <div class="card-body py-3">
                                <div class="text-muted small">Total Units</div>
                                <div class="fs-3 fw-bold" t-esc="truckStats.total"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.vehicle_state === 'available' ? 'bg-light' : 'border-0'}"
                             style="border-top: 3px solid #28a745 !important;"
                             t-on-click="() => this.selectVehicleState('available')">
                            <div class="card-body py-3">
                                <div class="text-muted small">Available</div>
                                <div class="fs-3 fw-bold text-success" t-esc="truckStats.available"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.vehicle_state === 'in_service' ? 'bg-light' : 'border-0'}"
                             style="border-top: 3px solid #0d6efd !important;"
                             t-on-click="() => this.selectVehicleState('in_service')">
                            <div class="card-body py-3">
                                <div class="text-muted small">In Service</div>
                                <div class="fs-3 fw-bold text-primary" t-esc="truckStats.in_service"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.vehicle_state === 'not_available' ? 'bg-light' : 'border-0'}"
                             style="border-top: 3px solid #fd7e14 !important;"
                             t-on-click="() => this.selectVehicleState('not_available')">
                            <div class="card-body py-3">
                                <div class="text-muted small">Not Available</div>
                                <div class="fs-3 fw-bold" style="color:#fd7e14;" t-esc="truckStats.not_available"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div role="button"
                             t-attf-class="card shadow-sm rounded-3 h-100 #{state.filters.vehicle_state === 'disabled' ? 'bg-light' : 'border-0'}"
                             style="border-top: 3px solid #6c757d !important;"
                             t-on-click="() => this.selectVehicleState('disabled')">
                            <div class="card-body py-3">
                                <div class="text-muted small">Disabled</div>
                                <div class="fs-3 fw-bold text-secondary" t-esc="truckStats.disabled"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="trucks-filters mb-3">
                    <form class="o_portal_search_form w-100" role="search" t-on-submit.prevent="">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md">
                                <input t-on-input="(ev) => this.updateFilter('search', ev.target.value)"
                                    t-att-value="state.filters.search" type="text" name="search"
                                    class="form-control" placeholder="Search plate, economic number, driver or UUID..." />
                            </div>
                            <div class="col-6 col-md-auto">
                                <select t-on-change="(ev) => this.updateFilter('vehicle_state', ev.target.value)"
                                    t-att-value="state.filters.vehicle_state" name="vehicle_state_search" class="form-select">
                                    <option value="">State: All</option>
                                    <t t-foreach="state.vehicleStateOptions" t-as="option" t-key="option[0]">
                                        <option t-att-value="option[0]" t-esc="option[1]"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-auto">
                                <select t-on-change="(ev) => this.updateFilter('vehicle_type', ev.target.value)"
                                    t-att-value="state.filters.vehicle_type" name="vehicle_type_search" class="form-select">
                                    <option value="">Vehicle Type</option>
                                    <t t-foreach="vehicleTypeOptions" t-as="option" t-key="option[0]">
                                        <option t-att-value="option[0]" t-esc="option[1]"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-auto">
                                <a href="#" class="small" t-on-click.prevent="clearFilters">Clear Filters</a>
                            </div>
                        </div>
                    </form>
                </div>

                <PaginationComponent pagination="pagination">
                    <table class="usuarios-table">
                        <thead class="thead-light">
                            <tr>
                                <th role="button" class="text-nowrap" t-on-click="() => this.toggleSort('economic_number')">Economic number <i t-att-class="this.sortIcon('economic_number')"/></th>
                                <th t-if="this.isColumnVisible('license_plate')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('license_plate')">License plate <i t-att-class="this.sortIcon('license_plate')"/></th>
                                <th t-if="this.isColumnVisible('model')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('model')">Make / model / year <i t-att-class="this.sortIcon('model')"/></th>
                                <th t-if="this.isColumnVisible('vehicle_type')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('vehicle_type')">Vehicle type <i t-att-class="this.sortIcon('vehicle_type')"/></th>
                                <th t-if="this.isColumnVisible('driver')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('driver')">Driver <i t-att-class="this.sortIcon('driver')"/></th>
                                <th t-if="this.isColumnVisible('state')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('state')">Status <i t-att-class="this.sortIcon('state')"/></th>
                                <th t-if="this.isColumnVisible('current_event')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('current_event')">Current event <i t-att-class="this.sortIcon('current_event')"/></th>
                                <th t-if="this.isColumnVisible('last_change')" role="button" class="text-nowrap" t-on-click="() => this.toggleSort('last_change')">Last change <i t-att-class="this.sortIcon('last_change')"/></th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pagination.paginatedItems" t-as="truck" t-key="truck.id">
                                <tr>
                                    <td>
                                        <t t-esc="truck.x_economic_number or 'N/A'"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('license_plate')">
                                        <t t-esc="truck.license_plate or 'N/A'"/>
                                        <span t-if="truck.x_federal_license_plates" class="badge rounded-pill ms-1" style="background-color:transparent; border:1px solid #A4E3F5; color:#6c757d;">Fed</span>
                                    </td>
                                    <td t-if="this.isColumnVisible('model')">
                                        <t t-esc="truckModelName(truck)"/>/<t t-esc="truck.model_year or 'N/A'"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('vehicle_type')">
                                        <t t-esc="truck.x_vehicle_type ? truck.x_vehicle_type[1] : 'N/A'"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('driver')">
                                        <t t-esc="truckDriverName(truck)"/>
                                    </td>
                                    <td t-if="this.isColumnVisible('state')">
                                        <span t-attf-class="badge rounded-pill px-2 py-1
                                            #{truck.x_vehicle_service_state == 'available' ? 'bg-success bg-opacity-10 text-white':
                                              truck.x_vehicle_service_state == 'in_service' ? 'bg-primary bg-opacity-10' :
                                              truck.x_vehicle_service_state == 'not_available' ? 'bg-warning bg-opacity-10' :
                                              'bg-secondary bg-opacity-10 text-primary'}">
                                            <t t-esc="truck.x_vehicle_service_state ? truck.x_vehicle_service_state_label : 'N/A'"/>
                                        </span>
                                    </td>
                                    <td t-if="this.isColumnVisible('current_event')">
                                        <t t-if="truck.current_event">
                                            <div><a href="#" t-on-click.prevent="() => this.openEventSummary(truck)" t-esc="'Evento ' + truck.current_event.name"/></div>
                                            <small class="text-muted" t-esc="truck.current_event.stage"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td t-if="this.isColumnVisible('last_change')">
                                        <t t-if="truck.last_state_change_date">
                                            <div t-esc="truck.last_state_change_date"/>
                                            <small class="text-muted" t-esc="truck.last_state_change_user"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-primary btn-sm rounded-pill px-3 text-nowrap" t-on-click.prevent="() => this.showDetails(truck.id)">View details</button>
                                            <div class="position-relative">
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm px-2"
                                                        t-att-disabled="state.updatingTruckId === truck.id"
                                                        title="Actions"
                                                        t-on-click.stop="() => this.toggleActionsMenu(truck.id)">
                                                    <i t-att-class="state.updatingTruckId === truck.id ? 'fa fa-spinner fa-spin' : 'fa fa-ellipsis-v'"/>
                                                </button>
                                                <ul t-if="state.actionsMenuTruckId === truck.id"
                                                    class="dropdown-menu dropdown-menu-end d-block"
                                                    style="position:absolute; top:100%; right:0; z-index:1000;">
                                                    <li>
                                                        <button type="button"
                                                                t-attf-class="dropdown-item #{this.canEditVehicleStatus(truck) ? '' : 'disabled'}"
                                                                t-on-click="() => this.onChangeStatusClick(truck)">
                                                            <i class="fa fa-exchange me-2"/><t>Change status</t>
                                                        </button>
                                                    </li>
                                                    <!--
                                                        Temporarily hidden: permanent deregistration.
                                                        Its validation, evidence, verification-code and
                                                        audit flows remain in place for a future release.
                                                    <li t-if="this.canDeregisterTruck(truck)"><hr class="dropdown-divider"/></li>
                                                    <li t-if="this.canDeregisterTruck(truck)">
                                                        <button type="button" class="dropdown-item text-danger"
                                                                t-on-click="() => this.onPermanentDeregistrationClick(truck)">
                                                            <i class="fa fa-ban me-2"/><t>Permanently deregister</t>
                                                        </button>
                                                    </li>
                                                    -->
                                                    <li t-if="truck.x_vehicle_service_state === 'deregistration'"><button type="button" class="dropdown-item" t-on-click="() => this.openDeregistrationHistory(truck)"><i class="fa fa-history me-2"/><t>View deregistration history</t></button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="!state.trucks.length">
                                <td t-att-colspan="this.truckColumnCount" class="text-center">No trucks found.</td>
                            </tr>
                        </tbody>
                    </table>
                </PaginationComponent>
            </div>
            <!-- VIEW 2: TRUCK DETAILS -->
            <div t-if="!state.isLoading and state.view === 'list' and state.selectedTruckId">
                <TruckReadComponent
                    truckId="state.selectedTruckId"
                    onCancel="() => this.showList()"
                />
            </div>
            <div t-if="!state.isLoading and state.view === 'create'">
                <TruckCreateComponent
                    onTruckCreated="() => this.onTruckCreated()"
                    onCancel="() => this.showList()"
                />
            </div>
            <!-- First confirmation: complete and review the permanent deregistration request. -->
            <div t-if="state.temporaryDowntime.show" class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5); z-index:1060;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><t>Temporarily unavailable</t></h5>
                            <button type="button" class="btn-close" t-on-click="() => state.temporaryDowntime.show = false"/>
                        </div>
                        <div class="modal-body">
                            <label class="form-label"><t>Reason</t> *</label>
                            <select class="form-select mb-3" t-model="state.temporaryDowntime.reason">
                                <option value=""><t>Select a reason</t></option>
                                <t t-foreach="state.temporaryDowntime.reasons" t-as="reason" t-key="reason.value">
                                    <option t-att-value="reason.value" t-esc="reason.label"/>
                                </t>
                            </select>
                            <label class="form-label"><t>Estimated return date</t> *</label>
                            <input class="form-control" type="date" t-model="state.temporaryDowntime.returnDate"/>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" t-on-click="() => state.temporaryDowntime.show = false"><t>Cancel</t></button>
                            <button class="btn btn-primary" t-on-click="saveTemporaryDowntime"><t>Save</t></button>
                        </div>
                    </div>
                </div>
            </div>
            <div t-if="state.deregistrationHistory.show" class="modal show d-block deregistration-history-modal" tabindex="-1" style="background-color:rgba(0,0,0,.5); z-index:1060;">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fa fa-history me-2"/><t>Deregistration history</t></h5>
                            <button type="button" class="btn-close" t-on-click="() => state.deregistrationHistory.show = false" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <dl class="row mb-4 deregistration-history-data">
                                <dt class="col-sm-4"><t>Economic number</t></dt><dd class="col-sm-8" t-esc="state.deregistrationHistory.data.economic_number"/>
                                <dt class="col-sm-4"><t>License plate</t></dt><dd class="col-sm-8" t-esc="state.deregistrationHistory.data.license_plate"/>
                                <dt class="col-sm-4"><t>Reason</t></dt><dd class="col-sm-8" t-esc="state.deregistrationHistory.data.reason"/>
                                <dt class="col-sm-4"><t>Date</t></dt><dd class="col-sm-8" t-esc="state.deregistrationHistory.data.date"/>
                                <dt class="col-sm-4"><t>User</t></dt><dd class="col-sm-8" t-esc="state.deregistrationHistory.data.user"/>
                            </dl>
                            <section class="deregistration-evidence-section">
                                <h6><i class="fa fa-paperclip me-2"/><t>Evidence</t></h6>
                                <div t-if="state.deregistrationHistory.data.evidence.length" class="list-group list-group-flush">
                                    <t t-foreach="state.deregistrationHistory.data.evidence" t-as="evidence" t-key="evidence.id">
                                        <div class="list-group-item d-flex align-items-center justify-content-between gap-3">
                                            <span class="text-truncate"><i class="fa fa-file-o me-2 text-muted"/><t t-esc="evidence.name"/></span>
                                            <a class="btn btn-sm btn-outline-primary flex-shrink-0" t-att-href="evidence.download_url">
                                                <i class="fa fa-download me-1"/><t>Download</t>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                                <p t-else="" class="text-muted mb-0"><t>No evidence was attached.</t></p>
                            </section>
                        </div>
                    </div>
                </div>
            </div>
            <div t-if="state.deregistration.showRequest" class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5); z-index:1060;">
                <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content border-0 shadow">
                    <div class="modal-header"><h5 class="modal-title"><t>Permanently deregister unit</t></h5>
                        <button type="button" class="btn-close" t-on-click="closeDeregistrationModals" aria-label="Close"/></div>
                    <div class="modal-body">
                        <p class="text-muted"><t>To continue, enter the unit information and confirm its license plate.</t></p>
                        <dl class="row small mb-3">
                            <dt class="col-sm-4"><t>Economic number</t></dt><dd class="col-sm-8" t-esc="state.deregistration.truck.economic_number"/>
                            <dt class="col-sm-4"><t>License plate</t></dt><dd class="col-sm-8" t-esc="state.deregistration.truck.license_plate"/>
                            <dt class="col-sm-4"><t>Vehicle type</t></dt><dd class="col-sm-8" t-esc="state.deregistration.truck.vehicle_type"/>
                            <dt class="col-sm-4"><t>Deregistration type</t></dt><dd class="col-sm-8">Permanent</dd>
                        </dl>
                        <div t-if="state.deregistration.warningEvents.length" class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle me-2"/><t>The unit has events in Assistance Completed or Verifying that will continue their financial closure:</t>
                            <strong t-esc="state.deregistration.warningEvents.join(', ')"/>
                        </div>
                        <div t-if="state.deregistration.isLastUnitOfType" class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle me-2"/><t>This is the last active unit of this vehicle type in its service center.</t>
                        </div>
                        <div class="mb-3"><label class="form-label"><t>Reason</t> *</label>
                            <select class="form-select" t-model="state.deregistration.reason"><option value=""><t>Select a reason</t></option>
                                <t t-foreach="state.deregistration.reasons" t-as="reason" t-key="reason.id"><option t-att-value="reason.id" t-esc="reason.name"/></t>
                            </select>
                        </div>
                        <div class="mb-3"><label class="form-label"><t>Evidence</t> *</label>
                            <input class="form-control" type="file" multiple="multiple" t-on-change="onDeregistrationEvidenceChange"/>
                            <small t-if="state.deregistration.evidenceName" class="text-muted" t-esc="state.deregistration.evidenceName"/>
                            <small class="d-block text-muted"><t>Maximum 4 files, 3 MB each.</t></small>
                        </div>
                        <div><label class="form-label"><t>License plate confirmation</t> *</label>
                            <input class="form-control" type="text" t-model="state.deregistration.licensePlate" t-att-placeholder="state.deregistration.truck.license_plate"/>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" t-on-click="closeDeregistrationModals"><t>Cancel</t></button>
                        <button type="button" class="btn btn-danger" t-att-disabled="state.deregistration.isSaving" t-on-click="requestDeregistrationCode"><i t-if="state.deregistration.isSaving" class="fa fa-spinner fa-spin me-1"/><t>Request verification code</t></button></div>
                </div></div>
            </div>
            <!-- Second confirmation: only the one-time code executes the irreversible action. -->
            <div t-if="state.deregistration.showCode" class="modal show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5); z-index:1060;">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
                    <div class="modal-header"><h5 class="modal-title"><t>Confirm permanent deregistration</t></h5><button type="button" class="btn-close" t-on-click="cancelDeregistrationRequest" aria-label="Close"/></div>
                    <div class="modal-body"><p><t>Enter the six-digit verification code sent by email and portal notification. The code expires in 10 minutes.</t></p>
                        <label class="form-label"><t>Verification code</t></label><input class="form-control" maxlength="6" inputmode="numeric" t-model="state.deregistration.code"/>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" t-on-click="cancelDeregistrationRequest"><t>Cancel request</t></button><button type="button" class="btn btn-danger" t-att-disabled="state.deregistration.isSaving" t-on-click="confirmPermanentDeregistration"><i t-if="state.deregistration.isSaving" class="fa fa-spinner fa-spin me-1"/><t>Permanently deregister</t></button></div>
                </div></div>
            </div>
        </div>
    </t>
</templates>
