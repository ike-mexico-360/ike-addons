<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ike_event_portal.ServiceCommentDialog" owl="1">
        <!-- Modal Backdrop -->
        <div class="modal-backdrop fade show" style="z-index: 1055;"/>

        <!-- Modal -->
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1056;">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <!-- Header -->
                    <div class="modal-header bg-primary text-white rounded-top-4 border-0">
                        <h5 class="modal-title">
                            <i class="fa fa-comment me-2"/>
                            <t t-esc="props.title"/>
                        </h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                aria-label="Close"
                                t-on-click="closeDialog"/>
                    </div>

                    <!-- Body -->
                    <div class="modal-body p-4">
                        <div class="alert alert-danger py-2 mb-3" t-if="state.error">
                            <t t-esc="state.error"/>
                        </div>
                        <label class="form-label small text-muted fw-semibold mb-1">
                            <i class="fa fa-pencil me-1"/>
                            <span>Comment:</span>
                        </label>
                        <textarea class="form-control rounded-3 mb-4"
                                  rows="3"
                                  t-att-value="state.comment"
                                  t-att-disabled="state.isSubmitting"
                                  placeholder="Write your comment here..."
                                  t-on-input="onCommentInput"/>

                        <div class="table-responsive border rounded-3"
                             style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-nowrap">
                                        <span>Date:</span>
                                        </th>
                                        <th><span>Comment:</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-if="state.isLoadingComments">
                                        <td colspan="2" class="text-center text-muted py-4">
                                            <span class="spinner-border spinner-border-sm me-2"/>
                                            <span>Loading comments...</span>
                                        </td>
                                    </tr>
                                    <tr t-elif="!state.comments.length">
                                        <td colspan="2" class="text-center text-muted py-4">
                                            <span>No comments registered</span>
                                        </td>
                                    </tr>
                                    <t t-else="" t-foreach="state.comments" t-as="item" t-key="item.id">
                                        <tr>
                                            <td class="text-nowrap"><t t-out="formatDate(item.create_date)"/></td>
                                            <td class="text-break" style="white-space: pre-wrap;">
                                            <t t-out="item.comment"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2"
                             t-if="state.total">
                            <small class="text-muted">
                                <t t-out="state.total"/>
                                <span>Comments</span>
                            </small>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="previousPage"
                                        t-att-disabled="state.page &lt;= 1 or state.isLoadingComments">
                                    <i class="fa fa-chevron-left"/>
                                </button>
                                <small class="text-nowrap">
                                    <t t-out="state.page"/> / <t t-out="pageCount"/>
                                </small>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        t-on-click="nextPage"
                                        t-att-disabled="state.page &gt;= pageCount or state.isLoadingComments">
                                    <i class="fa fa-chevron-right"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer border-0 pt-0">
                        <button type="button"
                                class="btn btn-outline-secondary rounded-pill px-4"
                                t-on-click="closeDialog"
                                t-att-disabled="state.isSubmitting">
                            <i class="fa fa-times me-1"/>
                            <span>Cancel</span>
                        </button>
                        <button type="button"
                                class="btn btn-primary rounded-pill px-4"
                                t-on-click="SaveComment"
                                t-att-disabled="!isValid or state.isSubmitting">
                            <t t-if="state.isSubmitting">
                                <span class="spinner-border spinner-border-sm me-2" role="status"/>
                                <span>Saving...</span>
                            </t>
                            <t t-else="">
                                <i class="fa fa-check me-1"/>
                                <span>Save</span>
                            </t>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
